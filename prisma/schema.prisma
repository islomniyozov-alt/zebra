// ============================================================================
// TRUCKING TMS — DATABASE SCHEMA
// ============================================================================
//
// CONVENTIONS — read before touching this file.
//
// 1. MONEY is ALWAYS an Int of CENTS. Never Float, never Decimal for money.
//    Field names end in `Cents`. $2,500.00 -> 250000.
//
// 2. PERCENTAGES are Int BASIS POINTS. 30% -> 3000. 27.5% -> 2750.
//    Field names end in `Bps`.
//
// 3. TENANCY IS TWO LEVELS.
//    `organizationId` is the TENANT boundary — the carrier group, what a
//    subscription is sold to. Postgres row-level security enforces it. A bug
//    in application code physically cannot return another org's rows.
//    `companyId` is the OPERATING AUTHORITY inside the group (its own MC/DOT,
//    insurance, factoring, invoice series). It is a business field, scoped by
//    role in the application layer. Its failure mode is seeing your own other
//    company's loads; the org boundary's failure mode is a data breach.
//    Never write a raw query that bypasses either.
//
// 4. STATUS IS TWO AXES. A load has an operational status AND a billing
//    status. They move independently. Cancellation is a third, orthogonal
//    flag. Never collapse these into one enum.
//
// 5. SNAPSHOTS: settlements and invoices freeze the rule/rate that applied at
//    the time. Changing a driver's pay percentage must never retroactively
//    change a settlement that was already generated.
//
// 6. SOFT DELETE on anything financial or document-related (`deletedAt`).
//    DOT/FMCSA and IFTA record retention are statutory. Nothing is ever hard
//    deleted.
//
// 7. DOCUMENTS POINT OUTWARD. Document rows carry nullable FKs to the things
//    they belong to. Parent tables do NOT carry `...DocumentId` fields.
//    This keeps one relation per pair and one place to look.
//
// 8. NUMBER ALLOCATION goes through the Counter table with an atomic
//    increment. Never MAX(id)+1 — that collides under concurrency.
//
// 9. CHILD TABLES CARRY A DENORMALIZED `organizationId`. Postgres row-level
//    security cannot traverse a foreign key, so eleven tables that own no
//    tenant of their own — LoadStop, InvoiceLine, SettlementLine and the rest
//    — repeat the parent's organizationId purely so a policy can be written
//    against them. A BEFORE INSERT OR UPDATE trigger overwrites the column
//    from the parent on every write, so the parent is always the authority
//    and the copy cannot drift. It is REQUIRED in the model on purpose: a
//    caller that forgets it gets a type error, not a silently invisible row.
//    Deliberately no FK to Organization — the parent already has one, and
//    eleven more back-relations on Organization would earn nothing.
//    User and Session are NOT in this set. A user belongs to several
//    organizations through Membership, and login has to read User before any
//    organization is known. They stay outside RLS by design; see the
//    migration's closing note.
// ============================================================================

// TWO CLIENTS, because one cannot serve both runtimes.
//
// The default build instantiates its WASM query compiler from base64 at
// runtime. workerd forbids that outright — "Wasm code generation disallowed by
// embedder" — so the Workers build has to be generated with runtime = "workerd",
// which emits `import "./query_compiler_fast_bg.wasm?module"` instead and lets
// the bundler compile it ahead of time.
//
// That import is not valid JS to Vite or Node, so it cannot be the client the
// tests, the seed and `next dev` use. Hence both, and next.config.ts swaps one
// for the other in the production bundle. Anything running on Node gets the
// first; the deployed Worker gets the second.
generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
}

generator workerd {
  provider     = "prisma-client"
  output       = "../src/generated/prisma-workerd"
  runtime      = "workerd"
  moduleFormat = "esm"
}

// Prisma 7: the connection string no longer lives here. It is supplied in
// prisma.config.ts (for migrations) and via the driver adapter passed to the
// PrismaClient constructor at runtime. On Cloudflare Workers use the Neon
// WebSocket adapter — the HTTP driver cannot run interactive transactions,
// and settlement generation and invoicing both need them.
datasource db {
  provider = "postgresql"
}

// ============================================================================
// TENANCY, USERS, ACCESS
// ============================================================================

// ============================================================================
// ORGANIZATION — THE TENANT BOUNDARY
// ============================================================================
//
// An Organization is a carrier GROUP. It is what a subscription is sold to and
// it is the wall row-level security enforces. Nothing crosses it, ever.
//
// A Company inside it is an OPERATING AUTHORITY — its own MC, DOT, insurance,
// factoring and invoice series. Which authority a load runs under is a
// compliance fact (running under the wrong authority is an FMCSA problem), so
// it is a required field on the load, not a UI mode.
//
// Shared across authorities: customers/brokers, facilities, factoring
// companies, users. Enter a broker once for the whole group.
// Specific to one authority: loads, invoices, settlements, and the trucks and
// drivers currently operating under it.
// ============================================================================

model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique

  tier     PlanTier @default(INTERNAL)
  isActive Boolean  @default(true)

  // Plan limits. Multi-authority is the paid capability — a single-company
  // customer never sees authority pickers or company columns anywhere.
  maxCompanies Int  @default(1)
  maxTrucks    Int?
  maxUsers     Int?

  billingEmail String?
  notes        String?

  // WHICH TENANT AN INBOUND EMAIL BELONGS TO (Phase 6 §4 step 4).
  //
  // `loads@zebratms.com` is one address on one domain, and the application is
  // multi-tenant — so the recipient is the routing key, and it lives here
  // rather than in the mail worker's configuration. A worker that knew which
  // organization to hand mail to would be a second place tenancy is decided,
  // and the first rule of this schema is that there is one.
  //
  // Unique across the deployment: two organizations claiming one address is
  // freight delivered to whichever row the query happened to find first.
  // Nullable because most tenants never turn this on.
  inboundAddress String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies                Company[]
  inboundEmails            InboundEmail[]
  assetHistory             AssetAssignment[]
  customers                Customer[]
  locations                Location[]
  factors                  FactoringCompany[]
  auditLogs                AuditLog[]
  calendarEvents           CalendarEvent[]
  claims                   Claim[]
  accidents                Accident[]
  communications           Communication[]
  complianceItems          ComplianceItem[]
  inspections              RoadsideInspection[]
  violations               InspectionViolation[]
  dataQs                   DataQsChallenge[]
  claimParties             ClaimParty[]
  claimNotes               ClaimNote[]
  customerAliases          CustomerAlias[]
  corrections              ExtractionCorrection[]
  extractionUsage          ExtractionUsage[]
  counters                 Counter[]
  documents                Document[]
  drivers                  Driver[]
  expenses                 Expense[]
  fuelTxns                 FuelTransaction[]
  iftaMileage              IftaMileage[]
  integrations             Integration[]
  invoices                 Invoice[]
  loads                    Load[]
  maintenance              MaintenanceRecord[]
  memberships              Membership[]
  notifications            Notification[]
  payments                 Payment[]
  pendingUploads           PendingUpload[]
  settlements              Settlement[]
  settlementBatches        SettlementBatch[]
  seriesCounters           SeriesCounter[]
  settlementLoadLines      SettlementLoadLine[]
  settlementDeductionLines SettlementDeductionLine[]
  openingBalances          DriverOpeningBalance[]
  recurringDeductions      RecurringDeduction[]
  settlementCharges        SettlementCharge[]
  escrowEntries            DriverEscrowEntry[]
  trailers                 Trailer[]
  trucks                   Truck[]
  preferences              UserPreference[]
  randomRates              RandomTestingRate[]
  randomPoolEntries        RandomPoolEntry[]
  randomDraws              RandomDraw[]
  randomSelections         RandomSelection[]
}

enum PlanTier {
  INTERNAL
  SOLO
  FLEET
  GROUP
  ENTERPRISE
}

model Company {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  legalName    String?
  dotNumber    String?
  mcNumber     String?
  scac         String?
  ein          String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String  @default("US")
  phone        String?
  email        String?
  logoUrl      String?
  timezone     String  @default("America/Chicago")

  isActive Boolean @default(true)

  /// An authority this carrier group no longer operates under, kept because
  /// its freight is real.
  ///
  /// THE ONE AUTHORITY A NEW LOAD LANDS ON.
  ///
  /// Create Load used to default to `authorities[0]` — first alphabetical —
  /// which is how a draft opened from an inbound email got booked under
  /// whichever carrier happened to sort first rather than the one the
  /// operation actually runs on.
  ///
  /// AT MOST ONE PER ORGANIZATION, and the database says so: a partial
  /// unique index over `organizationId WHERE "isDefault"`. At LEAST one is
  /// not something an index can promise — a fresh organization has none
  /// until somebody picks — so the form falls back to first-alphabetical,
  /// which is the behaviour this replaces rather than a new hole.
  isDefault Boolean @default(false)

  /// NOT `isActive`, AND THE DIFFERENCE IS THE POINT. Deactivating takes an
  /// authority we still own out of service: it leaves every picker AND the
  /// load list's authority filter, and one click in the interface brings it
  /// back. A retired authority is the opposite arrangement — it must never be
  /// offered for NEW freight, and must stay visible everywhere history is
  /// read, because 2,757 imported Datatruck loads are filed under three of
  /// them and an authority you cannot filter to is history you cannot find.
  ///
  /// So retired rows stay `isActive: true` and the two flags never contradict
  /// each other. Creation surfaces ask for both; history surfaces ask for
  /// neither.
  retired Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings            CompanySettings?
  memberScopes        MembershipCompany[]
  assetHistory        AssetAssignment[]
  counters            Counter[]
  integrations        Integration[]
  factoringCompanies  FactoringCompany[]
  trucks              Truck[]
  trailers            Trailer[]
  drivers             Driver[]
  loads               Load[]
  documents           Document[]
  invoices            Invoice[]
  payments            Payment[]
  settlements         Settlement[]
  expenses            Expense[]
  fuelTxns            FuelTransaction[]
  maintenance         MaintenanceRecord[]
  iftaMileage         IftaMileage[]
  complianceItems     ComplianceItem[]
  inspections         RoadsideInspection[]
  dataQs              DataQsChallenge[]
  communications      Communication[]
  notifications       Notification[]
  calendarEvents      CalendarEvent[]
  auditLogs           AuditLog[]
  claims              Claim[]
  accidents           Accident[]
  pendingUploads      PendingUpload[]
  settlementLoadLines SettlementLoadLine[]
  randomPoolEntries   RandomPoolEntry[]
  randomDraws         RandomDraw[]

  @@unique([organizationId, dotNumber])
  @@index([organizationId, isActive])
}

model CompanySettings {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  organizationId String // denormalized from Company — convention 9

  // Invoicing
  invoiceNumberPrefix String  @default("INV-")
  invoiceTermsDays    Int     @default(30)
  invoiceNotes        String?
  remitToText         String?

  // Default assumptions used by the profitability engine. These are settings,
  // not constants — §30 requires the math be configurable.
  defaultFuelCostPerMileCents Int     @default(55)
  defaultMpg                  Decimal @default(6.5) @db.Decimal(5, 2)
  factoringFeeBps             Int     @default(300)
  dispatchFeeBps              Int     @default(0)

  // Notification lead times (days)
  complianceWarnDays  Int @default(30)
  podMissingAlertDays Int @default(3)
  invoiceOverdueDays  Int @default(1)

  /// The day a settlement week ENDS on.
  ///
  /// Phase 3 §11 said this field was here and unread; it was not here at all —
  /// PHASE-4-BRIEF.md §6 flag 2. Phase 3 step 6 hard-coded a Monday-to-Sunday
  /// week in `lastFullWeek`, and this is that constant made per-authority.
  ///
  /// 0 is Sunday, matching `Date.getUTCDay()` — the same numbering the code
  /// that reads it already speaks, so nothing has to translate.
  settlementWeekEndsOn Int @default(0)

  // Anything that doesn't deserve a column yet.
  extra Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  name         String
  phone        String?
  locale       String    @default("en") // en | ru | fa — driver portal needs these on day one
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  sessions       Session[]
  resetTokens    PasswordResetToken[]
  driverProfiles Driver[]

  loadsBooked        Load[]
  statusEvents       LoadStatusEvent[]
  assignmentsMade    LoadAssignment[]
  assetTransfers     AssetAssignment[]
  documentsUploaded  Document[]
  claimNotes         ClaimNote[]
  aliasesLearned     CustomerAlias[]
  correctionsMade    ExtractionCorrection[]
  accessorialsOk     LoadAccessorial[]
  paymentsRecorded   Payment[]
  settlementsOk      Settlement[]
  batchesFinalized   SettlementBatch[]      @relation("SettlementBatchFinalizedBy")
  batchesPaid        SettlementBatch[]      @relation("SettlementBatchPaidBy")
  loadGrossConfirmed Load[]                 @relation("LoadSettledGrossConfirmedBy")
  openingBalances    DriverOpeningBalance[]
  expensesCreated    Expense[]
  communications     Communication[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  calendarEvents     CalendarEvent[]
  pendingUploads     PendingUpload[]
  inboundEmails      InboundEmail[]
  preferences        UserPreference[]
  randomDraws        RandomDraw[]

  @@index([isActive])
}

// A user can belong to more than one company — you personally need RAM and
// Dolphins under one login. Role lives here, NOT on User.
model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role Role

  // Optional per-user overrides on top of the role, e.g. granting a specific
  // dispatcher visibility of load financials (§2).
  permissionOverrides Json?

  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // EMPTY means access to every authority in the org. Populate it to restrict
  // a dispatcher to specific companies.
  companyScopes MembershipCompany[]

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model MembershipCompany {
  id           String     @id @default(cuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  organizationId String // denormalized from Membership — convention 9

  @@unique([membershipId, companyId])
  @@index([companyId])
  @@index([organizationId])
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  DISPATCHER
  ACCOUNTING
  DRIVER
}

// One row per user per named preference, per organization.
//
// Deliberately a KEY/VALUE table rather than columns, and deliberately not
// localStorage. Two reasons, and the second is the one that matters:
//
//   * A saved view is "my trucks today" (§7.4) — a filter set a dispatcher
//     expects to find on the office machine AND on the laptop at home.
//     localStorage gives them one of the two and no way to notice.
//   * Density (§5.1) is the same shape of fact: small, per user, and useless
//     if it does not follow them. Step 7 needs it and it is not worth a second
//     mechanism, so this one is built to hold both from the start.
//
// Scoped by organization as well as user because a person may hold memberships
// in several, and "my trucks today" means different trucks in each.
model UserPreference {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * Namespaced: `view.loads.<slug>`, `density`, `columns.loads`.
   */
  key   String
  /**
   * Whatever the key's owner defines. Validated on read, never trusted.
   */
  value Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId, key])
  @@index([organizationId])
  @@index([userId, organizationId])
}

// Server-side sessions, not JWTs, because revocation has to be immediate: a
// dismissed dispatcher must lose access when the row dies, not when a token
// expires.
model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // SHA-256 of the token, never the token. The cookie holds the only copy of
  // the secret; this column is what remains if the database leaks, and it is
  // useless on its own. Renamed from `token` for exactly that reason — a
  // column called `token` invites being logged, compared loosely, or handed
  // back to a client.
  tokenHash String @unique

  // The resolved session context (§7). Resolved at login, refreshed when a
  // membership changes.
  //
  // NOT called `organizationId`, and the name is load-bearing. Every column
  // with that name is subject to row-level security, and this one is the
  // opposite: it is the INPUT to row-level security, read before any policy
  // can apply, and a policy on it would make login unresolvable. The
  // different name keeps the RLS audit honest instead of needing an exception
  // list. It also says the true thing — this is the organization the session
  // is currently acting as, of possibly several the user belongs to.
  activeOrganizationId String
  role                 Role
  // Empty means every authority in the organization. See companyScopeFilter.
  companyScopes        String[]
  // Copied from the membership so that `can()` has one input and no lookup.
  // Membership.permissionOverrides remains the source of truth; this is the
  // resolved copy, refreshed alongside role and scopes.
  permissionOverrides  Json?

  expiresAt DateTime
  // Set rather than deleted, so "when did this session end, and was it a
  // logout or an expiry" stays answerable.
  revokedAt DateTime?

  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([activeOrganizationId])
}

// Pre-authentication, so it carries no tenant and cannot: at the moment it is
// written nobody has proved who they are. Row-level security does not apply
// for the same reason it does not apply to User.
//
// Kept as rows rather than a counter so that "who tried, from where, when" is
// answerable after the fact. This is a system that moves money.
model LoginAttempt {
  id String @id @default(cuid())

  // Lowercased and trimmed, as presented. Recorded even when no such user
  // exists — the attempt happened either way.
  email     String
  ip        String?
  userAgent String?
  succeeded Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}

// A single-use, expiring permission to set a new password.
//
// Outside row-level security for the same reason as User, Session and
// LoginAttempt: it is issued and redeemed before anyone has proved who they
// are. It also cannot carry a tenant — the request arrives with an email
// address and nothing else.
//
// The token itself is never stored, only its SHA-256, exactly like Session.
// A leaked dump of this table is a list of digests that open nothing.
model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt DateTime
  // Set on redemption rather than deleted, so "was this link used, and when"
  // survives the reset. Single use is enforced by checking it, not by hoping
  // the row is gone.
  usedAt    DateTime?

  requestedIp String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// Atomic number allocation — load numbers, invoice numbers, settlement
// numbers. UPDATE ... RETURNING value+1 inside a transaction.
model Counter {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key            String // LOAD_NUMBER | INVOICE_NUMBER | SETTLEMENT_NUMBER
  value          Int          @default(1000)

  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
}

// §31 — integrations that are not connected must show as unavailable, never
// faked. This table is the single source of that truth.
model Integration {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  provider   IntegrationProvider
  status     IntegrationStatus   @default(NOT_CONFIGURED)
  configEnc  String? // encrypted blob — never plaintext credentials
  lastSyncAt DateTime?
  lastError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, provider])
}

enum IntegrationProvider {
  ELD_GPS
  FUEL_CARD
  FACTORING
  BANKING
  ACCOUNTING
  EMAIL
  SMS
  MAPS
  LOAD_BOARD
  OCR
  PAYMENTS
}

enum IntegrationStatus {
  NOT_CONFIGURED
  CONNECTED
  ERROR
  DISABLED
}

// ============================================================================
// FLEET
// ============================================================================

model Truck {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  unitNumber String
  vin        String?
  make       String?
  model      String?
  year       Int?
  plate      String?
  plateState String?

  currentOdometer Int?
  status          TruckStatus   @default(AVAILABLE)
  ownershipType   OwnershipType @default(OWNED)

  /// A SECOND AXIS BESIDE `status`, ANSWERING A DIFFERENT QUESTION.
  ///
  /// `status` is where the FREIGHT has the unit — AVAILABLE, DISPATCHED,
  /// IN_TRANSIT. This is whether the unit is fit to run at all: In service,
  /// Out of service, In shop. A tractor can be In shop and DISPATCHED on the
  /// same afternoon, and that is a thing to SEE rather than a contradiction
  /// to forbid — it is how a dispatcher finds the load that needs moving.
  ///
  /// TEXT AGAINST A CODE LIST, never a Postgres enum: the payment-type
  /// ruling and the same reasoning. The vocabulary is in
  /// `src/lib/fleet-codes.ts`, where a fourth value is an edit somebody can
  /// review rather than a migration against a table the whole fleet points
  /// at. There is no CHECK constraint, for the reason migration 52 records.
  fleetStatus String?

  /// Whose name is on the title. BLANK MEANS THE CARRIER OWNS IT.
  ///
  /// Null rather than the authority name repeated on 49 rows: "the carrier"
  /// is already `companyId`, and copying it here would be a second answer to
  /// a question the row already answers, free to disagree after a transfer.
  ownerName String?

  axles Int?

  /// TEXT against a code list, like `fleetStatus`. See `fleet-codes.ts`.
  fuelType String?

  /// Gross vehicle weight rating, in POUNDS — the unit every US document
  /// states it in, so there is nothing to convert and nothing to get wrong.
  grossWeightLbs Int?

  purchaseDate       DateTime?
  purchasePriceCents Int?
  notes              String?

  /// FREE TEXT, ORG-SCOPED, FILTERABLE. Datatruck's trucks export carries a
  /// `Tags` column and the history import brings it across where present.
  ///
  /// A STRING ARRAY RATHER THAN A TAG TABLE, deliberately. A join table would
  /// buy a canonical vocabulary — rename once, renamed everywhere — and cost a
  /// join on every list that filters. Nothing in the ruling asks for a
  /// vocabulary: it asks for free text that can be filtered, and the array with
  /// a GIN index is that, exactly. The day somebody wants to rename a tag
  /// across a fleet, this becomes a table and the migration is a backfill.
  tags String[] @default([])

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  drivers         Driver[]
  loads           Load[]
  assignments     LoadAssignment[]
  assetHistory    AssetAssignment[]
  documents       Document[]
  expenses        Expense[]
  fuelTxns        FuelTransaction[]
  maintenance     MaintenanceRecord[]
  iftaMileage     IftaMileage[]
  complianceItems ComplianceItem[]
  inspections     RoadsideInspection[]
  claims          Claim[]
  accidents       Accident[]

  // UNIQUENESS IS PARTIAL AND LIVES IN SQL. Prisma cannot express a `WHERE`
  // predicate on an index, so `truck_unit_per_company` is created by hand in
  // 20260730120000_partial_unique_on_soft_delete:
  //
  //   CREATE UNIQUE INDEX truck_unit_per_company
  //     ON "Truck"("companyId", "unitNumber") WHERE "deletedAt" IS NULL;
  //
  // A plain @@unique would let a REMOVED truck 101 keep holding the number
  // against a new one — a row the user cannot see blocking a row they are
  // trying to create. Same shape as the AssetAssignment open-period indexes.
  // Do not "restore" the @@unique.
  @@index([companyId, unitNumber])
  @@index([companyId, status])
  @@index([vin])
  @@index([tags], type: Gin)
}

enum TruckStatus {
  AVAILABLE
  DISPATCHED
  IN_TRANSIT
  MAINTENANCE
  OUT_OF_SERVICE
  SOLD
}

enum OwnershipType {
  OWNED
  LEASED
  OWNER_OPERATOR
}

// Not in the original spec, but trailer custody is exactly what the Amazon
// Relay claim dispute turned on. Track it.
model Trailer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  unitNumber    String
  vin           String?
  type          String? // dry van, reefer, flatbed
  year          Int?
  plate         String?
  plateState    String?
  status        TruckStatus   @default(AVAILABLE)
  ownershipType OwnershipType @default(OWNED)
  notes         String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  drivers         Driver[]
  loads           Load[]
  assignments     LoadAssignment[]
  assetHistory    AssetAssignment[]
  documents       Document[]
  maintenance     MaintenanceRecord[]
  complianceItems ComplianceItem[]
  inspections     RoadsideInspection[]

  // Partial, in SQL, for the reason recorded on Truck above.
  @@index([companyId, unitNumber])
  @@index([companyId, status])
}

model Driver {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Optional login for the driver portal. Not every driver gets one.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // The id this driver carried in the system they were migrated from.
  //
  // THE KEY A RE-RUN OF THE IMPORT MATCHES ON. Names are not stable — people
  // marry, and two Ivanovs get hired — so matching an import on
  // (company, first, last) works until exactly the day it silently merges two
  // people or splits one. The Datatruck export carries a stable numeric id on
  // all 54 rows; this is where it lands.
  //
  // NULL FOR ANYONE ADDED THROUGH THE INTERFACE, which is most drivers from
  // here on. Postgres treats NULLs as distinct in a unique index, so any
  // number of driver rows may have none.
  //
  // UNIQUE PER ORGANIZATION, not per company: a driver moves between sister
  // authorities (that is what `AssetAssignment` exists for) and their id in
  // the old system does not change when they do.
  externalId String?

  firstName String
  lastName  String
  phone     String?
  email     String?

  // ── THE DRIVER'S ADDRESS, USUALLY READ FROM FIELD 8 OF THE LICENCE ──────
  //
  // A LICENCE ADDRESS IS OFTEN STALE. Drivers move and do not update the card
  // — there is no reason to until it expires — so this is a starting point a
  // dispatcher confirms, NOT a source of truth. Nothing that must be right
  // may read it without a human having looked: not payroll, not a 1099, not
  // anything posted to a tax authority. The confirm form says so in words.
  //
  // NAMED `address*` RATHER THAN MATCHING `Company`'s BARE `city`/`state`.
  // Company can afford `state` because it has only one; a Driver already has
  // `cdlState`, and `driver.state` beside `driver.cdlState` is a pair somebody
  // will eventually mix up — in a payroll context, silently and in the wrong
  // direction. The prefix costs four characters and removes the question.
  //
  // AND `addressState` IS NOT `ExtractedCdl.addressStateCode`. That one is a
  // second reading of the ISSUING state, kept only to cross-check the header
  // and never stored. They agree on almost every card, which is exactly why
  // the distinction has to be written down rather than left to be noticed.
  addressLine1      String?
  addressCity       String?
  addressState      String?
  addressPostalCode String?

  cdlNumber String?
  cdlState  String?
  cdlClass  String?

  /// THE ONLY THING ITEM 11 STORES.
  ///
  /// Every other dispatch field — heading to, dispatch status, last
  /// activity, on-time delivery — is derived from rows that already exist.
  /// This one cannot be: a driver being on holiday leaves no trace in the
  /// freight, so somebody has to say so.
  ///
  /// `offDutyUntil` is when they are expected back; null means indefinite.
  /// A CHECK forbids a return date on a driver who is not off duty, so the
  /// two cannot disagree — the pair is the one shape here that could.
  isOffDuty    Boolean   @default(false)
  offDutyUntil DateTime?

  /// WHO THE CHEQUE IS MADE OUT TO, when it is not the driver.
  ///
  /// An owner-operator drives for us and invoices through their own LLC,
  /// and the statement has to say so — Datatruck's driver export carries a
  /// `Pay to` column for exactly this. Null is the normal case and means
  /// the driver's own name, which is why this is optional rather than a
  /// copy of the name kept in step.
  payToName    String?
  payToAddress String?

  hireDate        DateTime?
  terminationDate DateTime?
  status          DriverStatus  @default(AVAILABLE)
  employmentType  OwnershipType @default(OWNED)

  /// WHETHER THIS ROW IS A PERSON OR A REFERRAL PAYEE. `PERSON` | `PAYEE`.
  ///
  /// Owner's ruling, 2026-09-24. Rows like `7 Star` and `Said truck 3609` came
  /// across from Datatruck as drivers and are not people: they are referral
  /// payees, taking a commission on another driver's loads. They settle like
  /// anyone else and they keep their pay rules — the ruling is explicit that
  /// they are NOT to be inactivated, because inactivating them would stop
  /// paying them.
  ///
  /// What it changes is everything a HUMAN driver implies: a payee is out of
  /// the Driver Qualification File, out of the compliance warnings, out of the
  /// dispatch pickers and out of the roster counts. A DQF for `7 Star` is a
  /// medical certificate nobody will ever produce, and a compliance warning
  /// that can never be cleared trains people to ignore the ones that can.
  ///
  /// TEXT AGAINST A CODE LIST, not an enum, following `Truck.fleetStatus`. The
  /// list lives in `src/lib/driver-kind.ts` where the exclusions it drives are
  /// written next to it, and a value outside the list is refused there by
  /// name. An enum would put the two halves of one rule in two files.
  ///
  /// DEFAULT `PERSON`, so every existing row keeps meaning what it meant and
  /// the exclusions are opt-in. The failure direction matters: a payee wrongly
  /// left as a person produces a warning nobody can clear, while a person
  /// wrongly marked a payee silently leaves the DQF — which is the one the DOT
  /// asks about.
  kind String @default("PERSON")

  /// How many whole weeks after the batch's check date this driver is paid.
  ///
  /// ZERO FOR EVERYONE, BY RULING (Islom, 2026-09-11). The company pays two
  /// weeks behind for ALL drivers — a uniform cadence, not a per-driver
  /// property — so the lag lives in the batch's typed check date and not here.
  /// See MONEY-DESIGN §0.
  ///
  /// THE FIELD STAYS, deliberately. It was built for a per-driver lag that
  /// turned out not to exist, and it is kept because the day one driver IS
  /// paid on a different schedule, the alternative is a migration in the
  /// middle of a payroll week. It is not dead: `payoutDate` is still batch
  /// check date plus this, still frozen at FINAL, and the arithmetic is
  /// tested — it simply evaluates to the check date for every driver today.
  ///
  /// A STATED PROPERTY, LIKE THE PAY RULE — superseded rather than edited, so
  /// a settlement frozen at FINAL keeps the lag that applied when it was cut.
  payoutLagWeeks Int @default(0)

  assignedTruckId String?
  assignedTruck   Truck?  @relation(fields: [assignedTruckId], references: [id])

  /// THE SAME SHAPE AS `assignedTruckId`, WITH ONE DELIBERATE DIFFERENCE.
  ///
  /// A truck carries a team, so several drivers may point at one — there is
  /// no unique index above and there should not be. A TRAILER IS PULLED BY
  /// ONE, and a trailer sitting against two drivers is a data-entry error
  /// that sends two people to the same box. So there is a partial unique
  /// index, created by hand for the reason the truck-number one is:
  ///
  ///   CREATE UNIQUE INDEX driver_trailer_once ON "Driver"("assignedTrailerId")
  ///     WHERE "assignedTrailerId" IS NOT NULL AND "deletedAt" IS NULL;
  ///
  /// A removed driver must not keep holding a trailer against a live one,
  /// which is why the predicate carries `deletedAt` as well. `fleet.ts`
  /// refuses the second assignment in a sentence before Postgres has to.
  assignedTrailerId String?
  assignedTrailer   Trailer? @relation(fields: [assignedTrailerId], references: [id])

  notes String?

  /// FREE TEXT, ORG-SCOPED, FILTERABLE. Datatruck's drivers export carries a
  /// `Tags` column and the history import brings it across where present.
  ///
  /// A STRING ARRAY RATHER THAN A TAG TABLE, deliberately. A join table would
  /// buy a canonical vocabulary — rename once, renamed everywhere — and cost a
  /// join on every list that filters. Nothing in the ruling asks for a
  /// vocabulary: it asks for free text that can be filtered, and the array with
  /// a GIN index is that, exactly. The day somebody wants to rename a tag
  /// across a fleet, this becomes a table and the migration is a backfill.
  tags String[] @default([])

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  payRules            DriverPayRule[]
  loads               Load[]                 @relation("LoadDriver")
  /// Loads where this driver is the SECOND crew member. Named separately
  /// because `loads` must keep meaning "loads I am the driver of" — a single
  /// merged relation would quietly double every count that reads it.
  coDriverLoads       Load[]                 @relation("LoadCoDriver")
  settlementLoadLines SettlementLoadLine[]
  assignments         LoadAssignment[]
  assetHistory        AssetAssignment[]
  settlements         Settlement[]
  openingBalances     DriverOpeningBalance[]
  recurringDeductions RecurringDeduction[]
  settlementCharges   SettlementCharge[]
  escrowEntries       DriverEscrowEntry[]
  documents           Document[]
  expenses            Expense[]
  fuelTxns            FuelTransaction[]
  complianceItems     ComplianceItem[]
  inspections         RoadsideInspection[]
  claims              Claim[]
  accidents           Accident[]
  communications      Communication[]
  randomPoolEntries   RandomPoolEntry[]
  randomSelections    RandomSelection[]

  @@unique([organizationId, externalId])
  @@index([companyId, status])
  @@index([companyId, lastName])
  @@index([assignedTrailerId])
  @@index([tags], type: Gin)
}

enum DriverStatus {
  AVAILABLE
  DISPATCHED
  ON_ROUTE
  OFF_DUTY
  VACATION
  INACTIVE
}

// Versioned by effective date. Editing a driver's pay creates a NEW row; it
// never mutates the old one, so historical settlements stay reproducible.
model DriverPayRule {
  id       String @id @default(cuid())
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  organizationId String // denormalized from Driver — convention 9

  type         PayRuleType
  percentBps   Int? // 30% -> 3000
  perMileCents Int?
  flatCents    Int?

  // `expression` USED TO BE HERE, for PayRuleType.CUSTOM — a small sandboxed
  // language evaluated by the pay engine. Dropped in Phase 3 step 7 (flagged
  // in step 6, removed here) because nothing wrote it and nothing should:
  // paying a person by evaluating a string is a calculator nobody can review,
  // a parser nobody wrote, and an injection surface on the one table whose
  // output is somebody's wages.
  //
  // CUSTOM stays in the enum. Dropping an enum member is a rewrite of every
  // row that ever held it, and the four concrete rules are enforced in
  // driver-pay.ts where the refusal can say why. A fifth arrangement should
  // arrive as a fifth NAMED rule with its own arithmetic and its own test.

  effectiveFrom DateTime
  effectiveTo   DateTime?
  notes         String?

  createdAt DateTime @default(now())

  @@index([driverId, effectiveFrom])
  @@index([organizationId])
}

enum PayRuleType {
  PERCENT_GROSS
  PERCENT_LINEHAUL
  PER_MILE
  FLAT_PER_LOAD
  CUSTOM
}

// One table for every expiring document across trucks, trailers and drivers.
// This is what makes the calendar (§18) and the expiry notifications (§22) a
// single query instead of six special cases.
model ComplianceItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type ComplianceType

  truckId   String?
  truck     Truck?   @relation(fields: [truckId], references: [id])
  trailerId String?
  trailer   Trailer? @relation(fields: [trailerId], references: [id])
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id])

  identifier String? // policy number, permit number, CDL number
  issuer     String? // insurer, state, medical examiner
  issuedAt   DateTime?
  expiresAt  DateTime
  notes      String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  documents        Document[]
  randomSelections RandomSelection[]

  @@index([companyId, expiresAt])
  @@index([companyId, type, expiresAt])
}

enum ComplianceType {
  INSURANCE_LIABILITY
  INSURANCE_CARGO
  INSURANCE_PHYSICAL_DAMAGE
  REGISTRATION
  IRP
  IFTA_LICENSE
  DOT_INSPECTION
  ANNUAL_INSPECTION
  PERMIT
  CDL
  MEDICAL_CARD
  DRUG_TEST
  MVR
  /// 391.25(b) — the carrier's recorded REVIEW of the MVR, which is a
  /// separate obligation from obtaining it under 391.25(a). See dqf.ts.
  ANNUAL_REVIEW
  /// 382.701 — the FMCSA Drug & Alcohol Clearinghouse query. Not DRUG_TEST,
  /// which is a test result and a different thing with the same subject.
  CLEARINGHOUSE_QUERY
  OTHER
}

// Trucks, trailers and drivers move between sister authorities. Each row is
// the period one asset operated under one company. `effectiveTo = null` means
// it is the current owner.
//
// This is what makes "which authority operated truck 105 in Q2" answerable —
// which IFTA, IRP, insurance and DOT inspections all depend on. Moving an
// asset must never mean re-creating the record and losing its history.
model AssetAssignment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  truckId   String?
  truck     Truck?   @relation(fields: [truckId], references: [id])
  trailerId String?
  trailer   Trailer? @relation(fields: [trailerId], references: [id])
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  reason        String?

  createdByUserId String?
  createdBy       User?    @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  // Enforce a single OPEN period per asset with a partial unique index added
  // by hand in the migration:
  //   CREATE UNIQUE INDEX asset_open_period_truck
  //     ON "AssetAssignment"("truckId") WHERE "effectiveTo" IS NULL;
  //   ... and the same for trailerId and driverId.
  @@index([truckId, effectiveFrom])
  @@index([trailerId, effectiveFrom])
  @@index([driverId, effectiveFrom])
  @@index([companyId, effectiveFrom])
}

// ============================================================================
// COMMERCIAL — BROKERS, CUSTOMERS, FACILITIES
// ============================================================================

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  aliases CustomerAlias[]

  name      String
  type      CustomerType @default(BROKER)
  mcNumber  String?
  dotNumber String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String  @default("US")
  phone        String?
  email        String?
  billingEmail String?

  paymentTermsDays       Int            @default(30)
  preferredPaymentMethod PaymentMethod?
  /// What loads for this customer are booked as, unless somebody changes it.
  defaultPaymentType     String?
  creditLimitCents       Int?
  isFactorable           Boolean        @default(true)

  // The DEFAULT for loads booked under this customer. Amazon Relay settles by
  // weekly ACH statement rather than against invoices; the flag lives here so
  // a dispatcher never has to remember it, and is copied onto each load so
  // changing it later cannot rewrite freight that has already run.
  settlesDirectly Boolean @default(false)

  status        CustomerStatus @default(ACTIVE)
  // BIG M II is the reason this exists. Blocking a broker must be a first
  // class state, not a note nobody reads.
  blockedReason String?

  notes String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  contacts       CustomerContact[]
  loads          Load[]
  invoices       Invoice[]
  payments       Payment[]
  documents      Document[]
  communications Communication[]
  claims         Claim[]

  @@index([organizationId, status])
  @@index([organizationId, name])
  @@index([mcNumber])
}

enum CustomerType {
  BROKER
  SHIPPER
  DIRECT_CUSTOMER
}

enum CustomerStatus {
  ACTIVE
  ON_HOLD
  BLOCKED
  INACTIVE
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  organizationId String // denormalized from Customer — convention 9

  name      String
  title     String?
  phone     String?
  email     String?
  isPrimary Boolean @default(false)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([organizationId])
}

// Reusable shipper/receiver facilities so dispatchers stop retyping addresses.
model Location {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String   @default("US")
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)

  // IANA zone for this facility — "America/Chicago", never an abbreviation or
  // an offset. Nullable on purpose: an unknown zone is a fact, and a column
  // that defaulted to something would make every stop look certain.
  //
  // Design-system rule 3 wants the STOP's zone. Before this column existed it
  // was derived from the state, which is right for most of the country and
  // wrong for the thirteen states that span two zones. The derivation is still
  // the fallback; this is the override that makes a Florida panhandle dock
  // correct instead of approximately correct.
  timezone String?

  contactName  String?
  contactPhone String?
  hours        String?
  // What a driver is told to do on arrival. Phase 5 §3 step 4 calls this
  // "check-in instructions"; the column predates the name and keeps it.
  instructions String?
  // Internal. Not printed on anything a broker or a facility sees.
  notes        String?

  // PHASE 5 §3 STEP 4 — the two of the six the Location did not already carry.
  // A gate code is short, secret-ish and asked for at the gate; dock notes are
  // the sentence that saves an hour ("dock 4 only, back in from Elder Creek").
  gateCode  String?
  dockNotes String?

  // The address, folded, for matching an extracted stop to this facility.
  // Nullable because most Locations are lane endpoints typed as "Salem, OR" —
  // no street address means no key, and no key means no match, which is the
  // correct answer rather than a weak one. See src/lib/facility-memory.ts for
  // what the fold does and, more importantly, what it refuses to do.
  /// THE CARRIER-OWN CODE FOR THIS FACILITY: "MEM1", "DXH5",
  /// "KCDC_WAR_740370001_656". What Datatruck calls Company and what Relay
  /// paperwork prints, so it is the string a dispatcher and a CSV both have
  /// in hand when nothing else matches.
  ///
  /// EXACT LOOKUP, NEVER FUZZY. The address matcher in facility-memory.ts
  /// exists because addresses are written six ways; a code is written one
  /// way or it is a different facility.
  ///
  /// The unique index is also the seed idempotency key: re-importing the
  /// locations export upserts on (organizationId, facilityCode) and cannot
  /// duplicate. Nullable because most locations are typed by a dispatcher
  /// and have no code, and Postgres does not collide NULLs.
  facilityCode String?

  normalizedAddress String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  stops LoadStop[]

  @@unique([organizationId, facilityCode])
  @@index([organizationId, name])
  @@index([organizationId, state, city])
  @@index([organizationId, normalizedAddress])
}

model FactoringCompany {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Whose factor this is. Both authorities factor with Triumph and negotiate
  // their terms separately, so the terms live on a row PER CARRIER rather than
  // on one shared record with an exception written down somewhere else.
  //
  // Nullable because a factor can be on file before anybody decides which
  // authority uses it; the setup screen always sets it.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name        String
  contactName String?
  phone       String?
  email       String?

  // THE REMITTANCE ADDRESS, printed on every invoice this factor's authority
  // issues. Its own fields rather than the factor's corporate address, because
  // a factor's cheques go to a lockbox that is frequently in another state
  // from its offices — and the block on the invoice exists to tell somebody
  // where to send money, not who the company is.
  //
  // Nullable: a factor can be on file before the lockbox is confirmed, and an
  // invoice prints the lines it has.
  remitAddressLine1 String?
  remitAddressLine2 String?
  remitCity         String?
  remitState        String?
  remitPostalCode   String?

  /// The notice of assignment, printed under the remit-to block.
  ///
  /// TEXT ON THE RECORD, NOT A STRING IN THE RENDERER, and that is the whole
  /// point: every factor words this differently, RTS has not yet said what it
  /// requires, and the day they do it must be a field somebody edits rather
  /// than a deploy. `DT-015981` prints no notice at all — Datatruck's invoice
  /// carries the factor's NAME and nothing else — so this starts null and the
  /// block simply omits it until somebody fills it in.
  noticeOfAssignment String?

  advanceRateBps Int? // e.g. 9700 = 97% advance
  feeBps         Int? // e.g. 300 = 3%
  notes          String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  loads    Load[]
  invoices Invoice[]

  @@index([organizationId])
  @@index([companyId])
}

// ============================================================================
// LOADS
// ============================================================================

model Load {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  loadNumber      String // allocated via Counter
  referenceNumber String? // the broker's load/PRO number

  /// The id this load carried in the system it was migrated from.
  ///
  /// `Shipment ID` from Datatruck — the only column in that export unique
  /// across all 14,451 rows. `Load ID` looks like the key and is the
  /// CUSTOMER's reference: it repeats and it is sometimes blank, which is why
  /// it lands in `referenceNumber` and this exists.
  ///
  /// NULL FOR EVERYTHING BOOKED IN ZEBRA, which is every load from here on.
  externalId String?

  // PHASE 5 §3 STEP 5. The extraction has read both since step 1 and had
  // nowhere to put them: the step asks for a duplicate-BOL warning, and a
  // warning about a number the system never keeps cannot be written. Both are
  // the SHIPPER'S numbers rather than ours — never allocated here, only
  // recorded — which is why neither is unique: two loads legitimately carry one
  // BOL when a shipment is split, and the office wants to be told, not refused.
  bolNumber String?
  poNumber  String?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  truckId  String?
  truck    Truck?  @relation(fields: [truckId], references: [id])
  driverId String?
  driver   Driver? @relation("LoadDriver", fields: [driverId], references: [id])

  /// The second half of a TEAM: two drivers on one truck sharing the load,
  /// each paid their own percentage of the same gross.
  ///
  /// TEAM IS DERIVED, NOT STORED. `coDriverId != null` is the whole of it —
  /// no isTeam flag to disagree with the crew, no team table to go stale when
  /// somebody reassigns. Nothing else about teaming lives on the load.
  ///
  /// The two must DIFFER, and a database CHECK says so rather than the code
  /// remembering: one person listed twice on one load would settle as two crew
  /// members and be paid twice for it, wearing a second hat the second time.
  coDriverId String?
  coDriver   Driver? @relation("LoadCoDriver", fields: [coDriverId], references: [id])

  trailerId String?
  trailer   Trailer? @relation(fields: [trailerId], references: [id])

  // TWO AXES. See conventions note 4.
  operationalStatus LoadOperationalStatus @default(BOOKED)
  billingStatus     LoadBillingStatus     @default(UNINVOICED)
  isCancelled       Boolean               @default(false)
  cancelledAt       DateTime?
  cancelReason      String?

  equipmentType EquipmentType @default(DRY_VAN)
  commodity     String?
  weightLbs     Int?
  tempF         Int?
  isHazmat      Boolean       @default(false)
  isTeam        Boolean       @default(false)

  dispatchedMiles Int?
  actualMiles     Int?
  emptyMiles      Int?

  // Money. Accessorials are the SUM of billable LoadAccessorial rows; it is
  // stored denormalized for reporting but must be recomputed on write.
  linehaulCents      Int @default(0)
  fuelSurchargeCents Int @default(0)
  accessorialsCents  Int @default(0)
  totalRevenueCents  Int @default(0)

  // Driver pay is COMPUTED but the rule used is FROZEN onto the load, so a
  // later pay change cannot silently alter history.
  driverPayCents        Int   @default(0)
  driverPayRuleSnapshot Json?

  estimatedFuelCents   Int @default(0)
  estimatedProfitCents Int @default(0)

  /// The arrangement this load was booked under, stamped from the customer's
  /// default and editable afterwards.
  ///
  /// A LABEL, NOT A SWITCH. `isFactored` below still drives AR behaviour and
  /// is still what everything reads; this says what the desk agreed, which
  /// is the thing a person needs on the receivables list and cannot infer
  /// from a boolean.
  /// TEXT, VALIDATED IN CODE. Owner ruling, same reasoning as the
  /// deduction type: the four codes live in `src/lib/payment-types.ts`, so
  /// a fifth arrangement is an edit to a list rather than a migration.
  paymentType String?

  // Factoring materially changes AR behaviour — the factor collects, not you.
  isFactored         Boolean           @default(false)
  factoringCompanyId String?
  factoringCompany   FactoringCompany? @relation(fields: [factoringCompanyId], references: [id])
  factoringFeeCents  Int               @default(0)

  // Copied from Customer.settlesDirectly when the load is booked, and never
  // re-read from it. Amazon Relay pays RAM by ACH weekly — one statement
  // covering many loads, with no invoice anywhere in it. A direct-settled load
  // never becomes an invoice: it stays out of ready-to-invoice and out of
  // broker AR, is paid against by a statement, and its revenue still counts in
  // settlements and profitability.
  //
  // Its own column rather than a join to the customer, because a customer that
  // changes terms next year must not rewrite the billing history of freight
  // that has already run.
  directSettled Boolean @default(false)

  bookedByUserId String?
  bookedBy       User?    @relation(fields: [bookedByUserId], references: [id])
  bookedAt       DateTime @default(now())

  dispatcherNotes String?
  driverNotes     String?
  internalNotes   String?

  /// FREE TEXT, ORG-SCOPED, FILTERABLE. Datatruck's loads export carries a
  /// `Tags` column and the history import brings it across where present.
  ///
  /// A STRING ARRAY RATHER THAN A TAG TABLE, deliberately. A join table would
  /// buy a canonical vocabulary — rename once, renamed everywhere — and cost a
  /// join on every list that filters. Nothing in the ruling asks for a
  /// vocabulary: it asks for free text that can be filtered, and the array with
  /// a GIN index is that, exactly. The day somebody wants to rename a tag
  /// across a fleet, this becomes a table and the migration is a backfill.
  tags String[] @default([])

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  stops               LoadStop[]
  accessorials        LoadAccessorial[]
  statusEvents        LoadStatusEvent[]
  assignments         LoadAssignment[]
  documents           Document[]
  invoiceLines        InvoiceLine[]
  settlementLines     SettlementLine[]
  settlementLoadLines SettlementLoadLine[]

  /// When this load's packet was filed with the factor, and when a person
  /// marked it paid.
  ///
  /// WRITTEN BY THE TWO ACTIONS THAT CAUSE THEM, and by nothing else. Before
  /// these existed the money screen answered "the oldest unpaid filing" with
  /// `updatedAt`, which is right on the day a load is filed and drifts every
  /// time anything else touches the row — so a packet filed a fortnight ago
  /// could look filed this morning because somebody fixed a city name. A
  /// status with no timestamp cannot answer a question about age.
  filedAt DateTime?
  paidAt  DateTime?

  /// Dispatch's ruling on what this load actually settles on (MONEY-DESIGN §3).
  ///
  /// ONLY EVER SET BY A PERSON. Amazon freight settles on the REMITTED figure,
  /// and where the remittance matches the booked rate that is automatic. Where
  /// it is short or over, the line is HELD out of every settlement until
  /// somebody looks: short can mean a deduction we accept or a mistake we are
  /// going to argue about, and those pay the driver different amounts.
  ///
  /// Null is not only "nobody has looked yet" — it is also the ordinary state
  /// of every broker load, which settles on its rate and waits for nobody.
  settledGrossCents         Int?
  settledGrossConfirmedAt   DateTime?
  settledGrossConfirmedById String?
  settledGrossConfirmedBy   User?     @relation("LoadSettledGrossConfirmedBy", fields: [settledGrossConfirmedById], references: [id])

  expenses       Expense[]
  fuelTxns       FuelTransaction[]
  communications Communication[]
  claims         Claim[]

  // Money paid against the LOAD rather than against an invoice. Only ever
  // populated for direct-settled freight — see PaymentLoadApplication.
  paymentApplications PaymentLoadApplication[]
  settlementCharges   SettlementCharge[]
  corrections         ExtractionCorrection[]
  inboundEmails       InboundEmail[]

  @@unique([companyId, loadNumber])
  @@unique([organizationId, externalId])
  @@index([companyId, operationalStatus])
  @@index([companyId, billingStatus])
  @@index([companyId, customerId])
  @@index([companyId, driverId, bookedAt])
  /// The batch asks "which loads is this person crew on", which is
  /// `driverId = x OR coDriverId = x` — the first half rides the index above
  /// and without this the second half is a scan of 14,464 rows per driver.
  @@index([coDriverId])
  @@index([companyId, truckId, bookedAt])
  @@index([referenceNumber])
  @@index([organizationId, bolNumber])
  @@index([organizationId, poNumber])
  @@index([tags], type: Gin)
}

enum LoadOperationalStatus {
  AVAILABLE
  BOOKED
  DISPATCHED
  AT_PICKUP
  LOADED
  IN_TRANSIT
  AT_DELIVERY
  DELIVERED
  POD_RECEIVED
}

enum LoadBillingStatus {
  UNINVOICED
  READY_TO_INVOICE
  INVOICED
  PARTIALLY_PAID
  PAID
  DISPUTED
  WRITTEN_OFF

  /// Filed with the factor, awaiting their payment.
  ///
  /// One of the DECIDED statuses in `billing-status.ts`, for the reason the
  /// set exists: somebody pressed a button and handed a packet over. No
  /// arithmetic over invoices and payments can produce that fact or take it
  /// back, and `billingStatusFor` would compute INVOICED and undo it on the
  /// next drift sweep.
  ///
  /// It ends when a PERSON clicks PAID. Factoring money — the funded amount,
  /// the fee, the reserve — stays out of this system by ruling, so nothing
  /// arrives to move the status on its own.
  FILED_WITH_FACTOR

  /// Billed, or not billed, in Datatruck — before this system existed.
  ///
  /// One of the DECIDED statuses in `billing-status.ts`: `billingStatusFor`
  /// does not own it, so neither the writer nor the drift check will move it.
  /// See 20260909120000 for why a computed status could not express this.
  CLOSED_IN_DATATRUCK
}

enum EquipmentType {
  DRY_VAN
  REEFER
  FLATBED
  STEP_DECK
  POWER_ONLY
  TANKER
  CONTAINER
  OTHER
}

model LoadStop {
  id     String @id @default(cuid())
  loadId String
  load   Load   @relation(fields: [loadId], references: [id], onDelete: Cascade)

  organizationId String // denormalized from Load — convention 9

  sequence Int
  type     StopType

  // Either a saved facility or a one-off address.
  locationId   String?
  location     Location? @relation(fields: [locationId], references: [id])
  name         String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?

  appointmentType AppointmentType @default(APPOINTMENT)
  scheduledAt     DateTime?
  windowStart     DateTime?
  windowEnd       DateTime?
  arrivedAt       DateTime?
  departedAt      DateTime?

  /// THE LEG THAT ARRIVED HERE: its distance, and whether it carried freight.
  ///
  /// A Relay trip is legs, and legs flatten into this stop chain — so the leg
  /// is the edge INTO a stop and lives on the stop it ends at. The first stop
  /// of a trip has none, which is why both are nullable.
  ///
  /// NOT A LoadLeg TABLE. A second table would duplicate the chain and give
  /// two places to answer "what order did this trip run in", which is the
  /// question a dispatch board asks constantly.
  ///
  /// legEmpty comes from Shipper Account through the table in leg-purpose.ts.
  /// Null means nobody classified it; false means classified as loaded. The
  /// difference matters when Load.emptyMiles is summed.
  legMiles Int?
  legEmpty Boolean?

  referenceNumber String? // PU# / DEL#
  contactName     String?
  contactPhone    String?
  instructions    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([loadId, sequence])
  @@index([loadId])
  @@index([scheduledAt])
  @@index([organizationId])
}

enum StopType {
  PICKUP
  DELIVERY
  INTERMEDIATE
}

enum AppointmentType {
  APPOINTMENT
  FCFS
  WINDOW
}

// Detention, TONU, lumper and friends — each needs its own approval state
// because brokers dispute them individually.
model LoadAccessorial {
  id     String @id @default(cuid())
  loadId String
  load   Load   @relation(fields: [loadId], references: [id], onDelete: Cascade)

  organizationId String // denormalized from Load — convention 9

  type        AccessorialType
  amountCents Int
  // true  = billable to the broker (revenue)
  // false = a cost you ate (expense side of profitability)
  isBillable  Boolean           @default(true)
  status      AccessorialStatus @default(PENDING)

  /// THE IDEMPOTENCY KEY FOR AN IMPORTED CHARGE, when a file produced it.
  ///
  /// `<invoice number>:<trip or load id>:<item type>:<column>` — MONEY-DESIGN
  /// §2's key, written down. Re-uploading the same remittance must write
  /// nothing, and this is the constraint that makes that true in the database
  /// rather than in the importer's memory.
  ///
  /// NULL FOR EVERY HAND-ENTERED CHARGE, which is why the uniqueness is
  /// partial: Postgres does not collide nulls, so nothing existing is
  /// constrained by a column it does not use.
  sourceKey String?

  approvedByUserId String?
  approvedBy       User?     @relation(fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([loadId, sourceKey])
  @@index([loadId])
  @@index([status])
  @@index([organizationId])
}

enum AccessorialType {
  DETENTION
  LAYOVER
  TONU
  LUMPER
  EXTRA_STOP
  DRIVER_ASSIST
  REDELIVERY
  STORAGE
  FUEL_ADVANCE_FEE
  OTHER
}

enum AccessorialStatus {
  PENDING
  APPROVED
  BILLED
  DENIED
}

// Full status history. Powers the audit trail, dwell-time analytics, and the
// "no POD 3 days after delivery" alert — all for free.
model LoadStatusEvent {
  id     String @id @default(cuid())
  loadId String
  load   Load   @relation(fields: [loadId], references: [id], onDelete: Cascade)

  organizationId String // denormalized from Load — convention 9

  axis       StatusAxis
  fromStatus String?
  toStatus   String

  // Whether the load actually MOVED. Added in Step 5, because the timeline is
  // the audit answer and an answer that omits the refusals is a decoration.
  //
  // A REFUSED_STALE row is a transition that was attempted and declined for
  // arriving late — a Delivered click landing after the POD already did, say.
  // `fromStatus` is where the load stayed and `toStatus` is what was asked
  // for. Anything reconstructing the load's history filters to APPLIED; the
  // timeline shows both, because "somebody tried to mark this delivered on
  // Tuesday and the system said no" is exactly the kind of thing a dispute
  // turns on.
  outcome StatusOutcome @default(APPLIED)

  source          StatusSource @default(MANUAL)
  changedByUserId String?
  changedBy       User?        @relation(fields: [changedByUserId], references: [id])
  occurredAt      DateTime     @default(now())
  note            String?

  @@index([loadId, occurredAt])
  @@index([organizationId])
}

enum StatusAxis {
  OPERATIONAL
  BILLING
}

enum StatusSource {
  MANUAL
  AUTOMATIC
  DRIVER_PORTAL
  INTEGRATION
}

enum StatusOutcome {
  /**
   * The load moved.
   */
  APPLIED
  /**
   * Refused for arriving after a later state. The load did not move.
   */
  REFUSED_STALE
}

// Custody history. "Who had trailer X on July 14" must be answerable in one
// query — that question cost real money on the Amazon Relay claim.
model LoadAssignment {
  id     String @id @default(cuid())
  loadId String
  load   Load   @relation(fields: [loadId], references: [id], onDelete: Cascade)

  organizationId String // denormalized from Load — convention 9

  truckId   String?
  truck     Truck?   @relation(fields: [truckId], references: [id])
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id])
  trailerId String?
  trailer   Trailer? @relation(fields: [trailerId], references: [id])

  assignedAt       DateTime  @default(now())
  unassignedAt     DateTime?
  assignedByUserId String?
  assignedBy       User?     @relation(fields: [assignedByUserId], references: [id])
  reason           String?

  @@index([loadId])
  @@index([trailerId, assignedAt])
  @@index([truckId, assignedAt])
  @@index([driverId, assignedAt])
  @@index([organizationId])
}

// ============================================================================
// ROADSIDE INSPECTIONS (Phase 4 §3 step 4)
//
// The one part of Phase 4 the schema did NOT already contain — flags 1 and 6
// found ComplianceItem and MaintenanceRecord waiting; there is no inspection
// table anywhere, so this step migrates.
//
// An inspection is an EVENT, not a status. It happened on a date, at a scale
// house in a state, to some combination of a truck, a trailer and a driver,
// and it either wrote violations or it did not. Nothing about it is ever
// corrected in place: a clean inspection is a CSA asset for two years and a
// violation removed by a successful DataQs challenge is Step 5's business,
// recorded as an outcome on the challenge rather than by deleting the row.
// ============================================================================

model RoadsideInspection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // ALL THREE ARE NULLABLE, and at least one must be set — a CHECK constraint
  // in the migration enforces the floor, because Prisma cannot express it.
  // Level III is driver-only and Level V is vehicle-only with no driver
  // present, so requiring any particular one would make a real inspection
  // unrecordable.
  truckId   String?
  truck     Truck?   @relation(fields: [truckId], references: [id])
  trailerId String?
  trailer   Trailer? @relation(fields: [trailerId], references: [id])
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id])

  inspectedAt   DateTime
  level         InspectionLevel
  /// Two-letter jurisdiction. The state that wrote it, not where the carrier is.
  state         String
  /// The number printed on the report. Not allocated here — it comes off paper.
  reportNumber  String?
  location      String?
  inspectorName String?
  notes         String?

  // NOT STORED: whether the inspection was clean, and whether anything was put
  // out of service. Both are read off the violations — see inspections.ts. The
  // same argument §2.2 makes for compliance status: a stored flag is a cache of
  // a fact the children already carry, and it goes stale the moment a violation
  // is added.

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  violations InspectionViolation[]
  challenges DataQsChallenge[]
  documents  Document[]

  @@index([companyId, inspectedAt])
  @@index([companyId, truckId, inspectedAt])
  @@index([companyId, driverId, inspectedAt])
  @@index([companyId, trailerId, inspectedAt])
}

model InspectionViolation {
  id             String       @id @default(cuid())
  // No companyId of its own: the inspection carries the authority and this
  // inherits it. `organizationId` is DERIVED by the set_org trigger rather than
  // trusted from the caller — the same treatment as InvoiceLine and
  // SettlementLine.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  inspectionId String
  inspection   RoadsideInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  /// The FMCSA section, as written: "393.75(a)(3)". Free text, never an enum —
  /// the code list runs to thousands of entries and changes without notice.
  code        String
  description String?
  unit        ViolationUnit @default(VEHICLE)

  /// Out of service. Per VIOLATION, because that is where the officer writes it
  /// and because "which one grounded the truck" is the question a DataQs
  /// challenge has to answer.
  outOfService Boolean @default(false)

  /// CSA severity weight, 1–10, when it is known. Optional: the number comes
  /// from a table nobody has typed in yet, and a guessed weight would produce a
  /// BASIC score nobody could reproduce.
  severityWeight Int?

  // Soft delete for a mistyped code, and for nothing else. A violation the
  // carrier successfully challenged is not deleted — see the note above.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  challenges DataQsChallenge[]

  @@index([inspectionId])
  @@index([organizationId])
}

enum InspectionLevel {
  /// North American Standard — driver and vehicle, the full one.
  LEVEL_1
  /// Walk-around: driver and what can be checked without going under.
  LEVEL_2
  /// Driver-only: licence, medical card, hours, paperwork.
  LEVEL_3
  /// Special study, one-off.
  LEVEL_4
  /// Vehicle-only, driver not present.
  LEVEL_5
  /// Enhanced NAS for radioactive shipments.
  LEVEL_6
}

enum ViolationUnit {
  DRIVER
  VEHICLE
  HAZMAT
  OTHER
}

// A DataQs challenge — the carrier telling FMCSA that a violation is wrong.
//
// §1: "A DataQs challenge is its own record tied to a roadside
// inspection/violation, with a status and an outcome — not a note on a claim."
// So it hangs off the inspection, not off Claim, and it points at ONE violation
// when the carrier is disputing a specific code and at none when it is
// disputing the inspection itself (wrong carrier, wrong unit, duplicate
// filing) — which is a real and common challenge.
//
// STATUS AND OUTCOME ARE TWO FIELDS, not one. Status is where the challenge is;
// outcome is what came of it, and it stays null until FMCSA answers. Collapsing
// them would make "closed" ambiguous between won and lost.
model DataQsChallenge {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  inspectionId String
  inspection   RoadsideInspection   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  violationId  String?
  violation    InspectionViolation? @relation(fields: [violationId], references: [id])

  status  DataQsStatus   @default(DRAFT)
  outcome DataQsOutcome?

  /// Why the carrier says it is wrong. The substance of the filing.
  basis           String
  /// What FMCSA said. Recorded when the outcome is.
  outcomeNote     String?
  /// The RDR number DataQs hands back. Off their screen, not allocated here.
  referenceNumber String?

  submittedAt DateTime?
  decidedAt   DateTime?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  documents Document[]

  @@index([companyId, status])
  @@index([inspectionId])
  @@index([violationId])
}

enum DataQsStatus {
  /// Written up, not yet filed with FMCSA.
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  /// FMCSA answered. The answer is in `outcome`.
  CLOSED
}

enum DataQsOutcome {
  ACCEPTED
  PARTIALLY_ACCEPTED
  REJECTED
  /// The carrier pulled it. Not a loss, and worth telling apart from one.
  WITHDRAWN
}

// Cargo claims, accidents, shortages. Not in the original spec; you are
// actively disputing one right now.
model Claim {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  loadId     String?
  load       Load?     @relation(fields: [loadId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // PHASE-4-BRIEF.md §6 flag 15, resolved by the owner at Step 6. An accident
  // claim involves a tractor and a person, and until now the schema reached
  // them only through the optional load — which a bobtail accident does not
  // have. Both nullable: a cargo claim names neither.
  truckId  String?
  truck    Truck?  @relation(fields: [truckId], references: [id])
  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  type               ClaimType
  claimNumber        String?
  claimantName       String?
  status             ClaimStatus @default(OPEN)
  incidentAt         DateTime?
  amountClaimedCents Int?
  amountPaidCents    Int?
  description        String?
  resolution         String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  documents Document[]
  parties   ClaimParty[]
  notes_    ClaimNote[]
  accidents Accident[]

  @@index([companyId, status])
  @@index([loadId])
  @@index([truckId])
  @@index([driverId])
}

// Everyone with a stake in a claim. A cargo claim has at minimum a claimant
// and, once it is real, our insurer and their adjuster — with a reference
// number of their own that has nothing to do with ours. `Claim.claimantName`
// stays as the one-line summary the list column reads; this is the roll.
model ClaimParty {
  id             String       @id @default(cuid())
  // No companyId of its own: the claim carries the authority. `organizationId`
  // is DERIVED by the set_org trigger — see the migration.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  claimId String
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  role      ClaimPartyRole
  name      String
  phone     String?
  email     String?
  /// Their claim number, which is not ours. The field people copy off a letter.
  reference String?
  notes     String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([claimId])
  @@index([organizationId])
}

enum ClaimPartyRole {
  CLAIMANT
  INSURER
  ADJUSTER
  ATTORNEY
  /// The other carrier, in an accident that involved one.
  CARRIER
  WITNESS
  OTHER
}

// ONE TIMELINE, carrying both what somebody wrote and what the claim did.
//
// A note and a status change are the same kind of event to the person reading
// the history — "denied on the 8th, appealed on the 11th" is one story — and
// splitting them into two lists means reading two lists and merging them by
// hand. A status change is a row with `fromStatus`/`toStatus` set; a typed note
// is a row with a body. Both may be present: the ladder asks for a reason.
//
// Append-only. Nothing edits or deletes a row here, and there is no
// `deletedAt` on purpose — a timeline somebody can quietly revise is not an
// audit answer.
model ClaimNote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  claimId String
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  body       String?
  fromStatus ClaimStatus?
  toStatus   ClaimStatus?

  authorUserId String?
  author       User?   @relation(fields: [authorUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([claimId, createdAt])
  @@index([organizationId])
}

enum ClaimType {
  CARGO_DAMAGE
  CARGO_SHORTAGE
  ACCIDENT
  EQUIPMENT_DAMAGE
  FACILITY_INCIDENT
  OTHER
}

enum ClaimStatus {
  OPEN
  UNDER_REVIEW
  DISPUTED
  RESOLVED
  DENIED
  CLOSED
}

// ============================================================================
// CORRECTION MEMORY (Phase 5 §3 step 3)
//
// §1.4 is the whole design and it is a restraint rather than a feature: "'
// Learning' is data, not ML. Broker-name aliases and facility memory, written
// on dispatcher correction, applied on the next upload. No fine-tuning, no
// models trained."
//
// So there is no model here and no scoring. There are two tables: one that
// remembers a name, and one that remembers a correction. Everything the phase
// calls "learning" is a row in the first, written because somebody typed over
// what was extracted.
// ============================================================================

/// A broker name as it appears on paper, pointed at the Customer it means.
///
/// "ITS Logistics LLC" and "ITS National LLC" are DIFFERENT companies, which is
/// why the normalisation this table keys on folds case and spacing and nothing
/// else. Stripping legal suffixes would merge two of the owner's real brokers.
model CustomerAlias {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Exactly as the document printed it, for a human reading the row.
  alias      String
  /// Case- and space-folded. What the lookup matches on.
  normalized String

  /// How many uploads it has answered. A number to notice, not to act on.
  timesApplied Int @default(0)

  learnedByUserId String?
  learnedBy       User?   @relation(fields: [learnedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ONE MEANING PER SPELLING, per tenant. A second alias for the same string
  // would make the lookup order-dependent, and the order would be whatever the
  // database felt like.
  @@unique([organizationId, normalized])
  @@index([customerId])
}

/// One field somebody typed over after an extraction filled it.
///
/// §3 step 3: "the raw material for §5's accuracy numbers and nothing more."
/// Nothing reads this to change behaviour — the alias table is what changes
/// behaviour, and it is written from the same moment. This is the record.
model ExtractionCorrection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// The load the correction was made while creating, when there was one.
  loadId String?
  load   Load?   @relation(fields: [loadId], references: [id], onDelete: SetNull)

  /// The document it was extracted from. Kept after the mint becomes a
  /// Document so a correction can be traced to the page it disagreed with.
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  /// Dotted, the same paths the extraction uses: `brokerName`,
  /// `stops[0].city`, `money.linehaulCents`.
  field String

  /// BOTH SIDES, always. A correction that recorded only the new value would
  /// answer "what is it now" and not "what was wrong", and the second is the
  /// question §5's accuracy table asks.
  extractedValue String?
  correctedValue String?
  /// What the model claimed when it produced the value that was wrong.
  confidence     String?

  correctedByUserId String?
  correctedBy       User?   @relation(fields: [correctedByUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId, field])
  @@index([documentId])
  @@index([loadId])
}

/// WHAT ONE EXTRACTION COST, AS A ROW.
///
/// ── A LEDGER, NOT A COLUMN ON `Document` ─────────────────────────────────
///
/// The owner's ruling, and the reasons are worth writing down because the
/// convenient shape is the wrong one. A column on `Document` would tie the
/// cost to an artefact that need not exist: the CDL and the medical card are
/// read BEFORE anything is filed — that is the whole point of the confirm-then
/// -file flow — so most reads have no document to hang a number on. It would
/// also inherit `Document`'s lifecycle, and a deleted document would take its
/// cost with it, which is a ledger that can be edited by tidying up.
///
/// ONE ROW PER CALL TO AN ENGINE, including the calls whose answers were
/// refused. A read that cost money and produced nothing usable is still money,
/// and the refusal rate is precisely what a prompt change is trying to move.
///
/// ── WHY IT CARRIES THE TENANT ────────────────────────────────────────────
///
/// This is the per-customer cost ledger. When Zebra is multi-tenant, "what
/// does this customer cost us to serve" is a pricing question with real money
/// behind it, and the only honest answer is a sum over rows this tenant
/// caused. So `organizationId` is not bookkeeping here, it is the point, and
/// it carries the ordinary `org_isolation` policy like every other tenant
/// table.
///
/// NO FOREIGN KEY TO Document OR Driver ON PURPOSE. A cascade from either
/// would silently delete history the moment somebody removed a row, and a cost
/// ledger with holes is worse than no ledger — it reads as a smaller bill.
model ExtractionUsage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Which reader was called, in the vocabulary `Document` already speaks.
  ///
  /// REUSED RATHER THAN INVENTED. A parallel enum would be a second list of
  /// what a document can be, and the two would disagree the first time one of
  /// them gained a value — registration and annual inspection are already
  /// named as the next readers.
  documentType DocumentType

  /// Who ANSWERED, and who was asked when those differ.
  ///
  /// `model` is the engine that produced the tokens, so the price applied to
  /// them is the price of this string. `askedModel` is set only on a fallback:
  /// a month of quiet Sonnet bills after a Gemini outage is a question this
  /// pair can answer and a single column cannot.
  model      String
  askedModel String?

  /// Tokens, exactly as the engine reported them.
  ///
  /// THE MEASURED HALF. Everything else here is arithmetic over a constant
  /// somebody typed — `MODEL_PRICES`, recorded from a price list on a date —
  /// so the tokens are kept beside the money to be re-priced later. A published
  /// price change makes `milliCents` stale and leaves these true.
  inputTokens      Int
  outputTokens     Int
  cacheWriteTokens Int @default(0)
  cacheReadTokens  Int @default(0)

  /// THOUSANDTHS OF A CENT, because whole cents cannot tell 0.6 from 1.4 and
  /// those are different claims about a thousand loads a month. The same unit
  /// `costMilliCents` returns, stored as the integer it already is.
  milliCents Int

  /// Whether the rules accepted the answer these tokens bought.
  ///
  /// A refused read is billed exactly like an accepted one, so the row exists
  /// either way; this is what lets the ledger answer "how much did we spend on
  /// answers we threw away" without a second table.
  refused Boolean @default(false)
  /// The refusal, in the reader's own vocabulary — `low_confidence_expiry`,
  /// `unparsable`. Null when the read was accepted.
  reason  String?

  createdAt DateTime @default(now())

  /// The shape of the only question this table exists to answer: what did a
  /// tenant spend, over a period, broken down by document type.
  @@index([organizationId, createdAt])
  @@index([organizationId, documentType, createdAt])
}

// ============================================================================
// DOCUMENTS
// ============================================================================

model Document {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // R2 object key: {organizationId}/{entity}/{entityId}/{uuid}-{filename}
  // The tenant boundary is the prefix, so a bucket-level policy is expressible.
  // Never served from a public bucket — always a short-lived signed URL minted
  // behind an authorization check.
  r2Key     String  @unique
  filename  String
  mimeType  String
  sizeBytes Int
  sha256    String? // dedupe + integrity for disputes
  pageCount Int?

  type DocumentType

  // Documents point outward (convention 7). Exactly one of these is set.
  loadId            String?
  load              Load?               @relation(fields: [loadId], references: [id])
  truckId           String?
  truck             Truck?              @relation(fields: [truckId], references: [id])
  trailerId         String?
  trailer           Trailer?            @relation(fields: [trailerId], references: [id])
  driverId          String?
  driver            Driver?             @relation(fields: [driverId], references: [id])
  customerId        String?
  customer          Customer?           @relation(fields: [customerId], references: [id])
  invoiceId         String?
  invoice           Invoice?            @relation(fields: [invoiceId], references: [id])
  settlementId      String?
  settlement        Settlement?         @relation(fields: [settlementId], references: [id])
  expenseId         String?
  expense           Expense?            @relation(fields: [expenseId], references: [id])
  fuelTransactionId String?
  fuelTransaction   FuelTransaction?    @relation(fields: [fuelTransactionId], references: [id])
  maintenanceId     String?
  maintenance       MaintenanceRecord?  @relation(fields: [maintenanceId], references: [id])
  complianceItemId  String?
  complianceItem    ComplianceItem?     @relation(fields: [complianceItemId], references: [id])
  inspectionId      String?
  inspection        RoadsideInspection? @relation(fields: [inspectionId], references: [id])
  claimId           String?
  claim             Claim?              @relation(fields: [claimId], references: [id])
  dataQsId          String?
  dataQs            DataQsChallenge?    @relation(fields: [dataQsId], references: [id])

  // Populated later by the OCR pipeline (§32). Present from day one so that
  // enabling AI extraction is a background job, not a migration across
  // tens of thousands of rows.
  ocrStatus     OcrStatus @default(NOT_QUEUED)
  ocrText       String?
  extractedJson Json?
  ocrError      String?

  /// A better copy of this same document, when one has been made.
  ///
  /// Set by rotate-and-read: the turned card is stored as a NEW object and the
  /// original is left untouched — a document is evidence and retention is
  /// statutory — so this is what stops the driver's list flagging a card
  /// somebody has already dealt with.
  ///
  /// NOT A STATUS CHANGE, deliberately. Rewriting the original's `ocrStatus`
  /// would assert something about a READING that never happened to those
  /// bytes. What is true is narrower: there is now a better copy, and here it
  /// is.
  supersededByDocumentId String?
  supersededBy           Document?  @relation("DocumentSupersession", fields: [supersededByDocumentId], references: [id], onDelete: SetNull)
  supersedes             Document[] @relation("DocumentSupersession")

  uploadedByUserId String?
  uploadedBy       User?    @relation(fields: [uploadedByUserId], references: [id])
  uploadedAt       DateTime @default(now())

  // The mail this arrived as an attachment of (Phase 6 §4 step 4). Spec §12
  // wants the original openable from the load, and this is the thread back to
  // it — the email keeps the message, the Document keeps the file.
  inboundEmailId String?
  inboundEmail   InboundEmail? @relation(fields: [inboundEmailId], references: [id])

  deletedAt DateTime?
  updatedAt DateTime  @updatedAt

  corrections ExtractionCorrection[]

  @@index([companyId, type])
  @@index([inboundEmailId])
  @@index([loadId])
  @@index([driverId])
  @@index([truckId])
  // The inspection panel reads its reports by `inspectionId IN (…)` on every
  // asset screen. `complianceItemId` has no index for the same query and should
  // grow one; that is a separate migration and not this step's to smuggle in.
  @@index([inspectionId])
  @@index([dataQsId])
  @@index([ocrStatus])
  /// The question the driver's document list asks of every row it draws.
  @@index([supersededByDocumentId])
  @@index([sha256])
}

// A presigned PUT that was handed out and not yet confirmed.
//
// Kept as its own table rather than a PENDING-status Document on purpose: a
// status column makes correctness depend on every future read path remembering
// to filter it out, and the one that forgets shows a user a document that was
// never uploaded. A separate table cannot be forgotten — `Document` means
// "this file exists", always.
//
// It also makes reconciliation an indexed query instead of a bucket listing:
// expired rows are exactly the mints that never landed.
model PendingUpload {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // The key the URL was minted for. Unique, so a mint cannot be confirmed
  // twice into two Document rows.
  r2Key String @unique

  // What the URL is contractually bound to. R2 enforces all three by
  // signature; these are stored so confirm can check that what landed is what
  // was promised, rather than trusting the client's second account of it.
  filename  String
  mimeType  String
  sizeBytes Int
  sha256    String
  type      DocumentType

  // Which record the finished Document will hang off. Validated at mint time,
  // because the URL is the capability the moment it exists.
  //
  // NULLABLE SINCE PHASE 5. Upload-first create reads a rate confirmation
  // BEFORE the load exists (§1.5), so there is nothing to validate against at
  // mint and the target arrives at confirm instead. `companyId` still comes
  // from the session's authority, so a targetless mint is still inside a
  // tenant and inside an authority — what it is not yet inside is a record.
  targetEntity String?
  targetId     String?

  // Extraction, before the record exists (§1.5). Copied onto the Document at
  // confirm, which is why the column names match Document's exactly: a reader
  // comparing the two should not have to translate.
  //
  // It lives HERE rather than travelling through the browser because the
  // extraction contains money, and §1.3 keeps money off a dispatcher's wire.
  // A prefill that posted the rate back to be saved would put it in the one
  // place the rule exists to keep it out of.
  ocrStatus     OcrStatus @default(NOT_QUEUED)
  ocrText       String?
  extractedJson Json?
  ocrError      String?

  requestedByUserId String?
  requestedBy       User?   @relation(fields: [requestedByUserId], references: [id])

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([organizationId, expiresAt])
  @@index([targetEntity, targetId])
}

enum DocumentType {
  RATE_CONFIRMATION
  BOL
  POD
  LUMPER_RECEIPT
  SCALE_TICKET
  FUEL_RECEIPT
  DETENTION_PROOF
  INVOICE_PDF
  SETTLEMENT_PDF
  MAINTENANCE_RECEIPT
  INSURANCE_CERT
  REGISTRATION
  INSPECTION_REPORT
  CDL_COPY
  MEDICAL_CARD
  ACCIDENT_REPORT
  /// The three DQF items that do not expire (item 13). Documents rather than
  /// ComplianceItems because `expiresAt` is NOT NULL and an employment
  /// application has no expiry to invent. See dqf.ts.
  EMPLOYMENT_APPLICATION
  EMPLOYMENT_VERIFICATION
  ROAD_TEST_CERTIFICATE
  PHOTO
  OTHER
}

enum OcrStatus {
  NOT_QUEUED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED

  /// The card arrived and was never read, because nobody turned it upright.
  ///
  /// NOT `FAILED`, which means an engine was asked and could not answer. Here
  /// no engine was ever asked: the person cancelled the rotation step that
  /// precedes a read (owner's ruling, 2026-09-12), and the file was kept rather
  /// than dropped so that it shows on the driver as work outstanding.
  ///
  /// The two need different things done about them — one is retried, the other
  /// is turned the right way up — which is why this is a value and not an error
  /// string on FAILED.
  NEEDS_ROTATION
}

// ============================================================================
// INVOICING & ACCOUNTS RECEIVABLE
// ============================================================================

model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invoiceNumber String // allocated via Counter
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])

  status InvoiceStatus @default(DRAFT)

  issueDate   DateTime?
  dueDate     DateTime?
  /// The arrangement this demand is made under, stamped at raise from the
  /// loads it covers. Refused when they disagree — one invoice is one set of
  /// terms, and a mixture would be wrong about half the freight it names.
  paymentType String?

  termsDays Int @default(30)

  subtotalCents     Int @default(0)
  accessorialsCents Int @default(0)
  totalCents        Int @default(0)
  amountPaidCents   Int @default(0)
  balanceCents      Int @default(0)

  // A factored invoice is SOLD. The factor collects it. Aging, cash timing
  // and profitability all behave differently — do not treat it as normal AR.
  isFactored         Boolean           @default(false)
  factoringCompanyId String?
  factoringCompany   FactoringCompany? @relation(fields: [factoringCompanyId], references: [id])
  factoredAt         DateTime?
  factoringFeeCents  Int               @default(0)
  advanceCents       Int               @default(0)
  reserveReleasedAt  DateTime?

  sentAt      DateTime?
  sentToEmail String?
  notes       String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  lines        InvoiceLine[]
  applications PaymentApplication[]
  documents    Document[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, dueDate])
}

enum InvoiceStatus {
  DRAFT
  READY_TO_SEND
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  DISPUTED
  VOID
  WRITTEN_OFF
}

// An invoice can cover several loads (common with brokers who batch-pay).
model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  organizationId String // denormalized from Invoice — convention 9

  loadId String?
  load   Load?   @relation(fields: [loadId], references: [id])

  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitCents   Int
  amountCents Int
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([loadId])
  @@index([organizationId])
}

model Payment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  method          PaymentMethod
  referenceNumber String? // check number, ACH trace, wire ref

  /// The remittance this payment came from, when a file produced it.
  ///
  /// `<invoice number>` — Amazon's own, which is also the workbook's filename.
  /// Unique per organization so a second upload of one week finds the payment
  /// already there instead of creating a duplicate ACH.
  ///
  /// NULL FOR EVERY HAND-ENTERED PAYMENT. Nothing about the existing payment
  /// flows changes.
  remittanceKey String?

  /// The work period this remittance covers, parsed from the Payment Summary.
  ///
  /// `"Aug 30 - Sep 5, 2026"` is what Amazon prints, once, as a string —
  /// `parseWorkPeriod` turns it into these two days and refuses anything that
  /// is not a Sunday-to-Saturday week.
  ///
  /// NULLABLE, AND THE NULL IS A REAL STATE. Every payment entered by hand has
  /// no work period, and so does a remittance whose label this could not read.
  /// The money screen asks by these columns and falls back to asking what the
  /// payment actually paid for — a worse answer than the label, never a wrong
  /// one.
  periodStart DateTime?
  periodEnd   DateTime?

  receivedAt     DateTime
  amountCents    Int
  // Amount not yet applied to an invoice — a real state, not an error.
  unappliedCents Int      @default(0)

  /// AND `notes` IS CARRYING A FLAG IT SHOULD NOT BE — see `isAdjustment` below.
  notes          String?

  /// NOT A COLUMN YET, AND THE REASON IS THE SAME AS
  /// `RandomSelection.complianceItemId`'s.
  ///
  /// Owner's ruling, 2026-09-28: `isAdjustment Boolean @default(false)` goes into
  /// MIGRATION 61, bundled with the `RandomSelection.complianceItemId` drop,
  /// whenever a code change next needs the deploy ritual — not as a migration of
  /// its own.
  ///
  /// ── WHAT IS STANDING IN FOR IT MEANWHILE ────────────────────────────────
  ///
  /// `ADJUSTMENT_NOTE_PREFIX` in src/lib/amazon/remittance-write.ts, matched
  /// against `notes` by the money screen. A STRING STANDING IN FOR A BOOLEAN: it
  /// is written in one place and read in one place through a shared constant,
  /// which is the only thing that makes it tolerable.
  ///
  /// ── WHY THE FLAG IS NEEDED AT ALL ───────────────────────────────────────
  ///
  /// Owner's ruling, 2026-09-27: a workbook whose money is entirely
  /// `Adjustments - Dispute` books a Payment with ZERO applications, unapplied by
  /// design, shown on the money screen. The 2026-09-26 ruling says a payment that
  /// only declares the period and paid nothing into it is NOT the week's
  /// remittance.
  ///
  /// Those two are not in conflict, but they are indistinguishable BY SHAPE: a
  /// dispute credit has no applications, and neither does a freight remittance
  /// whose every unit is closed history — which is most of the corpus. So the
  /// writer has to mark it, and nothing on this row carries the fact otherwise.
  /// Keying on the absence of applications was tried and broke the earlier
  /// ruling's own guard on the first run.
  ///
  /// WHEN THE COLUMN LANDS, the money screen's second membership arm reads it
  /// instead of the prefix, and `ADJUSTMENT_NOTE_PREFIX` goes back to being only
  /// what it looks like — the first words of a human-readable note.

  recordedByUserId String?
  recordedBy       User?   @relation(fields: [recordedByUserId], references: [id])

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  applications     PaymentApplication[]
  loadApplications PaymentLoadApplication[]

  @@unique([organizationId, remittanceKey])
  @@index([companyId, periodStart])
  @@index([companyId, receivedAt])
  @@index([companyId, customerId])
}

// One check frequently pays several invoices, and one invoice can be paid in
// instalments. Modelling this as a join table is the single most important
// AR decision in the schema.
model PaymentApplication {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Denormalized from Payment — convention 9. The trigger also refuses the
  // write if the Invoice belongs to a different organization; a payment and
  // the invoice it settles can never be from different tenants.
  organizationId String

  amountCents Int
  appliedAt   DateTime @default(now())

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@index([organizationId])
}

// THE OTHER APPLICATION PATH, and the reason there are two.
//
// Amazon Relay pays RAM by ACH weekly: ONE statement covering many loads, with
// no invoice anywhere in it. Those loads carry `directSettled` and never become
// an invoice, so `PaymentApplication` — which requires one — has nothing to
// point at. Forcing an invoice into existence purely to receive the payment
// would put a document in the system that was never sent to anybody and never
// will be, and every AR figure would then count freight the broker settles by
// statement.
//
// So a payment applies to LOADS here, and to INVOICES there. The two paths are
// deliberately separate tables rather than one table with two nullable columns:
// a nullable pair admits a row that points at neither, and Postgres treats
// NULLs as distinct in a unique index, so the "one application per pair"
// guarantee would quietly stop holding.
//
// The difference between what the statement paid and what the loads are worth
// is an UNRECONCILED REMAINDER. It stays on the payment as unapplied money, or
// on the loads as an unpaid balance. It is never forced to match — a statement
// that disagrees with the freight is a question for Amazon, and a system that
// silently balances it destroys the only evidence that the question exists.
model PaymentLoadApplication {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  loadId    String
  load      Load    @relation(fields: [loadId], references: [id], onDelete: Cascade)

  // Denormalized from Payment — convention 9, same as PaymentApplication. The
  // trigger refuses the write if the Load belongs to a different organization.
  organizationId String

  amountCents Int
  appliedAt   DateTime @default(now())

  @@unique([paymentId, loadId])
  @@index([loadId])
  @@index([organizationId])
}

enum PaymentMethod {
  CHECK
  ACH
  WIRE
  ZELLE
  CREDIT_CARD
  FACTORING_ADVANCE
  FACTORING_RESERVE
  CASH
  OTHER
}

// ============================================================================
// DRIVER SETTLEMENTS
// ============================================================================

/// One company's Sunday-to-Saturday week, and every driver's statement under it.
///
/// ── WHY A BATCH EXISTS AT ALL ────────────────────────────────────────────
///
/// Because that is how the money actually moves. SB-000438 in
/// `corpus/datatruck` carries both RAM drivers for 8/16-8/22; the statement
/// date and the check date are typed once and every statement beneath it
/// inherits them. A per-driver settlement with its own dates would let two
/// drivers in one week be paid on days nobody chose.
///
/// ── THE TWO DATES ARE TYPED, NEVER DERIVED ───────────────────────────────
///
/// MONEY-DESIGN says so twice. On all six statements the check date happens to
/// be the statement date plus two, and deriving it from that pattern would be
/// inventing a rule out of a coincidence — the day a cheque is cut is an
/// operational decision, not arithmetic.
/// A number series that spans the whole organization rather than one authority.
///
/// ── WHY THIS IS NOT `Counter` ────────────────────────────────────────────
///
/// `Counter` is unique on `(companyId, key)` and that is correct for what it
/// holds: a load number and an invoice number belong to ONE authority, and RAM
/// and Dolphins each having their own series is the point of it.
///
/// Settlement batch and statement numbers are the opposite, and the artefact
/// says so plainly — SB-000436 RAM, SB-000437 Dolphins, SB-000438 RAM,
/// SB-000439 Dolphins, SB-000440 RAM. One ascending run, interleaved across
/// both carriers. Reusing `Counter` would mean picking one company to hold the
/// shared series in, which is a fact nothing in the schema could express and
/// the next person would have to be told.
///
/// Two tables because there are two scopes, not by accident.
model SeriesCounter {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// `SETTLEMENT_BATCH` or `SETTLEMENT_STATEMENT`.
  key   String
  value Int    @default(0)

  updatedAt DateTime @updatedAt

  @@unique([organizationId, key])
}

model SettlementBatch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // NO COMPANY. Islom's ruling of 2026-09-11: the sister companies are ONE
  // operation and settlement is org-wide. One batch per period for the whole
  // organization, one SB- number for the week, one statement per driver
  // whatever authority the freight was pulled under.
  //
  // THIS SUPERSEDES item 3's "batch per company per week", which came from the
  // artefact — SB-000438 covers both RAM drivers, and RAM and Dolphins had
  // separate batches. Datatruck's shape is not the argument; how the business
  // actually runs is, and it runs as one.
  //
  // INVOICES STAY PER AUTHORITY and so does `Counter`. An invoice carries an
  // authority's MC and goes outside; a statement is internal paperwork. The
  // two scopes now differ on purpose rather than by accident.

  /// Inclusive UTC days. A Sunday and the Saturday after — MONEY-DESIGN §0.
  periodStart DateTime
  periodEnd   DateTime

  statementDate DateTime
  checkDate     DateTime

  status SettlementBatchStatus @default(DRAFT)

  /// `SB-000436`. Allocated at FINAL; a draft carries none, because a number
  /// issued to something that may never exist is a gap in the series.
  batchNumber String?

  finalizedAt       DateTime?
  finalizedByUserId String?
  finalizedBy       User?     @relation("SettlementBatchFinalizedBy", fields: [finalizedByUserId], references: [id])
  paidAt            DateTime?
  paidByUserId      String?
  paidBy            User?     @relation("SettlementBatchPaidBy", fields: [paidByUserId], references: [id])

  notes String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  settlements Settlement[]

  /// ONE SERIES ACROSS BOTH CARRIERS, so the unique is on the organization and
  /// not the company. Confirmed off the artefact: 436 RAM, 437 Dolphins, 438
  /// RAM, 439 Dolphins, 440 RAM — one ascending run, interleaved.
  @@unique([organizationId, batchNumber])
  /// The money screen's lookup: is there a batch for this period yet.
  @@index([organizationId, periodStart])
  @@index([organizationId, status])
}

enum SettlementBatchStatus {
  DRAFT
  FINAL
  PAID
}

model Settlement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// THE LETTERHEAD. Whose name and address this statement prints.
  ///
  /// It used to be the batch's company, and the batch no longer has one. By
  /// ruling it is now THE AUTHORITY THAT OWNS THE TRUCK the settlement is
  /// frozen on — the same truck as `unitNumber`, resolved once at generation
  /// and frozen with it. A driver who pulls RAM and Dolphins freight in one
  /// week gets one statement, and it goes out under the authority whose truck
  /// he drove.
  ///
  /// Falls back to the driver's own company when no truck is assigned, because
  /// a statement with no letterhead is not a document.
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  settlementNumber String // allocated via Counter
  driverId         String
  driver           Driver @relation(fields: [driverId], references: [id])

  periodStart DateTime
  periodEnd   DateTime
  status      SettlementStatus @default(DRAFT)

  grossCents          Int @default(0)
  deductionsCents     Int @default(0)
  reimbursementsCents Int @default(0)
  netCents            Int @default(0)

  approvedByUserId String?
  approvedBy       User?          @relation(fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  paidAt           DateTime?
  paymentMethod    PaymentMethod?
  paymentReference String?
  notes            String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // ── THE BATCH FLOW (MONEY-DESIGN item 3) ──────────────────────────────
  //
  // NULLABLE, because the Phase 3 per-driver flow still creates settlements
  // without a batch. Both were empty on production when this landed — zero
  // rows, zero lines — so nothing here rewrites money somebody was paid.

  batchId String?
  batch   SettlementBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)

  /// PER-SETTLEMENT AND FROZEN AT FINAL. A driver changes truck mid-year and
  /// the statement has to keep the unit that pulled THAT week's freight —
  /// ST-005301 and ST-005336 are the same driver on units 0484 and 8842.
  unitNumber String?

  /// The other crew members, printed under the driver as "Team with X".
  ///
  /// FROZEN LIKE THE UNIT NUMBER, and for the same reason. It could be derived
  /// at render time by reading `Load.coDriverId` back through the load lines —
  /// and then reassigning a co-driver next year would silently restate a
  /// statement somebody was already paid on. The load lines beside this row
  /// freeze the city and the load number for exactly that argument.
  ///
  /// Empty on a solo period.
  teamWith String[]

  /// The REFERRAL PAYEES in the second seat, printed as "Referral: X".
  ///
  /// Owner's ruling, 2026-09-24. A referral payee takes a commission on another
  /// driver's loads and sits in `Load.coDriverId` to do it — so without this
  /// the statement prints "Team with 7 Star" under the driver, which is a false
  /// statement about who was in the truck on the one document that driver reads
  /// to check their own pay.
  ///
  /// A SECOND COLUMN RATHER THAN A LABEL INSIDE `teamWith`, because both are
  /// frozen and the freeze has to survive `Driver.kind` changing afterwards.
  /// Deriving the label at render time by reading the driver's kind back would
  /// restate an already-paid statement the day somebody reclassifies a row —
  /// the exact argument the comment above makes for freezing `teamWith` at all.
  referralWith String[]

  /// The payee as the statement printed it, FROZEN LIKE THE UNIT NUMBER.
  ///
  /// A statement is a document somebody was paid on. Reading
  /// `Driver.payToName` back at render time would let an owner-operator who
  /// changed LLC in November restate every statement they were paid on in
  /// March.
  ///
  /// Null means the statement printed the driver's own name — a fact about
  /// that statement, not an absence to be filled in later.
  payToName    String?
  payToAddress String?

  /// `88% from gross`, exactly as printed. Built from the rule at generation
  /// and frozen, so a later rate change cannot restate an issued statement.
  payTariffLabel  String?
  payRuleSnapshot Json?

  /// Batch check date plus the driver's own lag, frozen at FINAL. This is the
  /// Check Date the statement prints — see `Driver.payoutLagWeeks`.
  payoutDate DateTime?

  /// The Earnings section's Total row. `grossCents` is what the percentage was
  /// taken OF; `earningsCents` is the sum of the per-line rounded amounts, and
  /// the two are not a fixed ratio of each other because rounding is per line.
  earningsCents   Int @default(0)
  advancesCents   Int @default(0)
  otherPayCents   Int @default(0)
  /// Hundredths — the statements print 3.75 and 465.85 miles.
  milesHundredths Int @default(0)

  lines          SettlementLine[]
  loadLines      SettlementLoadLine[]
  deductionLines SettlementDeductionLine[]
  documents      Document[]

  /// ST- IS ONE SERIES ACROSS THE ORGANIZATION, so the unique is too. Keyed on
  /// the company it would have permitted two ST-000441s in different
  /// authorities — which is exactly what a shared counter must not allow.
  @@unique([organizationId, settlementNumber])
  @@index([companyId, driverId, periodEnd])
  @@index([companyId, status])
}

enum SettlementStatus {
  DRAFT
  APPROVED
  PAID
  VOID
}

model SettlementLine {
  id           String     @id @default(cuid())
  settlementId String
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  organizationId String // denormalized from Settlement — convention 9

  loadId String?
  load   Load?   @relation(fields: [loadId], references: [id])

  type            SettlementLineType
  description     String
  // SIGNED. Earnings positive, deductions negative. Net is a plain SUM.
  amountCents     Int
  // The exact pay rule applied, frozen. A later pay change cannot rewrite
  // this settlement.
  payRuleSnapshot Json?
  sortOrder       Int                @default(0)

  /// The driver's sheet dates, FROZEN at generation like payRuleSnapshot.
  /// PU = actual check-in at the first PICKUP; DEL = at the last DELIVERY.
  /// When no actual exists the plan is used and the flag says so, because a
  /// money document never presents a plan as an actual silently.
  puAt      DateTime?
  delAt     DateTime?
  puActual  Boolean   @default(false)
  delActual Boolean   @default(false)

  createdAt DateTime @default(now())

  @@index([settlementId])
  @@index([loadId])
  @@index([organizationId])
}

/// One load on one statement — the Earnings section, a row at a time.
///
/// SEPARATE FROM `SettlementLine` RATHER THAN REUSING IT. That table is one
/// signed amount with a type; this one carries the columns the artefact prints
/// — Load number, PU, DEL, PU date, DEL date, Load gross, Total miles, Total
/// amount — and every one of them has to survive on the statement whatever
/// happens to the load afterwards.
model SettlementLoadLine {
  id           String     @id @default(cuid())
  settlementId String
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  organizationId String // denormalized from Settlement — convention 9

  loadId String
  load   Load   @relation(fields: [loadId], references: [id])

  /// Which authority's freight this line is, frozen like everything else here.
  ///
  /// A statement can now carry lines from more than one company, and groups
  /// them under sub-headings when it does. Read through the load at render
  /// time it would silently regroup an issued statement the day somebody moved
  /// a load between authorities.
  companyId   String
  company     Company @relation(fields: [companyId], references: [id])
  companyName String

  /// FROZEN COPIES, not joins. A statement is a document somebody was paid on:
  /// re-reading the load next year to render it would let a corrected city or
  /// a re-numbered load change what a cheque said.
  loadNumber String
  puPlace    String
  delPlace   String
  puDate     DateTime
  delDate    DateTime

  /// The gross the percentage was applied to. For Amazon freight this is the
  /// REMITTED figure, never the booked rate — §3, and `settledBasis` says which.
  grossCents      Int
  milesHundredths Int
  /// The Total amount column: gross times the rule, rounded on THIS line.
  amountCents     Int

  /// `rate` | `remitted` | `confirmed`. What the gross above came from, so a
  /// driver querying a line can be told which figure was used and why.
  settledBasis String

  /// How the amount was reached — the rule, the basis, the result.
  payRuleSnapshot Json?

  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [organizationId], references: [id])

  /// Which crew member this line pays, denormalized from the settlement —
  /// convention 9, and here it carries the uniqueness below.
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id])

  /// A LOAD SETTLES ONCE PER DRIVER.
  ///
  /// THIS USED TO BE `@@unique([loadId])` — "a load settles once" — and the
  /// promise it was making is unchanged: a driver paid twice for one load is
  /// money out of the door that reconciles against nothing. What changed is
  /// that a TEAM load legitimately produces two lines, one for each crew
  /// member, and the old constraint forbade the second one outright.
  ///
  /// So the key gains the driver rather than losing its teeth. A team load
  /// pays two DIFFERENT drivers once each; the same driver still cannot be
  /// paid twice for the same load, by a re-run, by a second batch, or by being
  /// listed as both driver and co-driver — and that last one the `Load` CHECK
  /// refuses first, so it cannot even be written.
  ///
  /// A narrower key would have been `[loadId, settlementId]`, and it is not
  /// enough: two settlements for the SAME driver could each carry the load,
  /// which is exactly the cheque-twice case the original was written against.
  ///
  /// WHAT THIS KEY NO LONGER PROMISES, said plainly: the old one also meant
  /// "one line per load, full stop", so a SOLO load reassigned from one driver
  /// to another could not be settled to both. This one permits that, because
  /// the database cannot tell a legitimate second crew member from a second
  /// driver without reading `Load.coDriverId` — and a CHECK cannot cross
  /// tables. What holds the line instead is the engine, which builds a second
  /// line only when `coDriverId` is set, and the guard named "solo load gains
  /// a phantom line", watched failing. That is a weaker guarantee than a
  /// constraint and it is recorded here rather than assumed away.
  @@unique([loadId, driverId])
  @@index([settlementId])
  @@index([organizationId])
}

/// One deduction or one credit. Signed, so both sections come from one table.
///
/// The statement prints them as Deductions and Other Pay, which are the same
/// object pointing opposite ways — `SettlementCharge` is stored the same way
/// for the same reason.
model SettlementDeductionLine {
  id           String     @id @default(cuid())
  settlementId String
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  organizationId String // denormalized from Settlement — convention 9

  /// The printed label: `Fuel`, `Insurance`, `Ifta`, `Escrow`, `Other`.
  type        String
  /// Exactly what goes in the Description column. Empty prints blank, which is
  /// what `Ifta` and `Admin Fee` do on the real statements.
  description String

  quantity   Int @default(1)
  rateCents  Int
  /// SIGNED: negative is money off the driver, positive is Other Pay.
  totalCents Int

  /// Which rule or one-off produced it, so the line can be traced back.
  recurringDeductionId String?
  settlementChargeId   String?

  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([settlementId])
  @@index([organizationId])
}

enum SettlementLineType {
  LOAD_PAY
  ACCESSORIAL_PAY
  BONUS
  REIMBURSEMENT
  DEDUCTION_ADVANCE
  DEDUCTION_FUEL
  DEDUCTION_INSURANCE
  DEDUCTION_ESCROW
  DEDUCTION_EQUIPMENT
  DEDUCTION_VIOLATION
  DEDUCTION_OTHER
}

