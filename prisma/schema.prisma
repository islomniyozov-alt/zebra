// Written automatically by a Prisma client extension, never by hand. Hand
// placed audit calls end up around 60% covered, which is the same as useless.
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // NULLABLE, unlike every other companyId in this schema. Plenty of audited
  // things belong to the organization and to no single authority — a broker, a
  // saved facility, a user's membership. Requiring a company here would mean
  // either inventing one or declining to audit those writes, and the second is
  // how an audit trail quietly becomes 60% covered.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action     AuditAction
  entityType String
  entityId   String
  // { field: { from, to } } — one row per write, not one per field.
  changes    Json?
  ip         String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([companyId, entityType, entityId])
  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  // Company-less rows still have to be findable, and every audit query starts
  // from the tenant.
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  EXPORT
  PERMISSION_CHANGE
}

// ============================================================================
// EMAIL-IN (Phase 6 §4 step 4, spec §1 / §10 / §15)
// ============================================================================

/**
 * A booking email that arrived at the tenant's load inbox.
 * NOT A LOAD, AND DELIBERATELY NOT A `Load` ROW IN A DRAFT STATE. Adding DRAFT
 * to `LoadOperationalStatus` would put unconfirmed, machine-read freight into
 * every query that already exists — the dispatch board, ready-to-invoice,
 * settlement lines, the load-number counter — and every one of those would
 * have to learn to exclude it. One forgotten filter and a draft nobody has
 * read is on an invoice. So mail lands in its own table and becomes a Load
 * only when a dispatcher presses Save on the ordinary form.
 * WHICH IS EXACTLY WHAT §1.1 RULED: "the inbox is a queue of unfinished forms,
 * not a second editing surface". Opening one lands on `/loads/new` prefilled
 * from `extractedJson`, with the same validations and the same Save as a
 * pasted email or an uploaded PDF. There is no second way to create a load.
 */
model InboundEmail {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // No companyId. Mail arrives at the ORGANIZATION's address and nobody has
  // said which authority it belongs to yet — the dispatcher picks that on the
  // create form, where authority is field 1. A guess here would be a guess
  // printed on an invoice.

  // --- what arrived ---------------------------------------------------------
  //
  // `messageId` is the mail system's own idempotency key. Cloudflare can
  // deliver the same message more than once, and Amazon really does send a
  // booking, an update and a final confirmation in one thread — the first is a
  // duplicate to be ignored, the others are new mail about the same load and
  // are told apart by their own Message-ID.
  messageId String @unique

  fromAddress String
  toAddress   String
  subject     String?
  receivedAt  DateTime @default(now())

  /**
   * The whole message as it arrived. Spec §12: the source is openable.
   */
  rawR2Key String?
  rawBytes Int?

  /**
   * The body the reader was given, kept for the same reason `ocrText` is.
   */
  bodyText String?

  // --- what was read out of it ---------------------------------------------
  //
  // Column names match `PendingUpload` and `Document` exactly, so a reader
  // comparing the three has nothing to translate.
  ocrStatus     OcrStatus @default(NOT_QUEUED)
  ocrText       String?
  extractedJson Json?
  ocrError      String?

  /**
   * Which of the three the inbox shows. See InboundEmailState.
   */
  state InboundEmailState @default(REVIEW)

  /**
   * Why it is not READY, in message keys — never sentences.
   * Spec §10 wants "ready / review / conflict" and the brief adds "from real
   * validation results, not vibes". These are the results: the same
   * `LoadWarning` kinds the create form raises, computed when the mail is read
   * so the list can be sorted by them without re-reading anything.
   */
  concerns Json?

  /**
   * Set when a dispatcher turns it into freight, so it leaves the queue.
   */
  loadId          String?
  load            Load?     @relation(fields: [loadId], references: [id])
  confirmedAt     DateTime?
  dismissedAt     DateTime?
  dismissedReason String?

  handledByUserId String?
  handledBy       User?   @relation(fields: [handledByUserId], references: [id])

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, state, receivedAt])
  @@index([organizationId, receivedAt])
}

/// Mail that arrived at an address NO ORGANIZATION CLAIMS.
///
/// THIS TABLE EXISTS SO THAT "DELIVERED" AND "EXISTS NOWHERE" CANNOT BOTH BE
/// TRUE. `/api/inbound-email` answers 202 when no tenant claims the recipient
/// — deliberately, because a 4xx makes Cloudflare retry mail that can never
/// route and a bounce tells a stranger which addresses exist. But a 202 is an
/// acknowledgement: the sending server marks the message delivered and stops.
/// Until this table, that acknowledgement was a lie — the message was
/// discarded with a `console.warn` and nothing else.
///
/// IT CANNOT CARRY A TENANT, which is the whole point of it. The message is
/// here precisely because the question "whose is this?" was asked and answered
/// NO. A policy on `organizationId` could never be satisfied, the same
/// argument `Session` and `LoginAttempt` make in tests/structure.test.ts. It
/// therefore sits outside row-level security, and the exact list in that test
/// is where that decision is defended.
///
/// KEYED ON THE MESSAGE-ID, NOT A CONTENT HASH. Measured, not assumed: one
/// message redelivered three times grew by a byte between attempts as the
/// sender rewrote a trace header (PHASE-6-BRIEF flag 58). A hash of the raw
/// `.eml` would have recorded the same message twice.
model UnroutedEmail {
  id String @id @default(cuid())

  /// The mail system's own idempotency key. Redelivery finds this row.
  messageId String @unique

  fromAddress String
  toAddress   String
  subject     String?

  /// Kept even though the `.eml` usually holds it: R2 can fail, and a message
  /// with no readable trace is the thing this table exists to prevent.
  bodyText String?

  /// The whole message, when it could be stored. Null means the object write
  /// failed or the message was too large to carry — `rawBytes` still says how
  /// big it was, so the gap is visible rather than invisible.
  rawR2Key String?
  rawBytes Int?

  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([receivedAt])
}

enum InboundEmailState {
  /// Read cleanly, nothing worth stopping for.
  READY
  /// Read, but something wants a person: a missing date, a probable duplicate.
  REVIEW
  /// Could not be read at all, or contradicts freight already booked.
  CONFLICT
  /// NO USABLE READING EXISTS, and `ocrStatus` says which kind of nothing.
  ///
  /// Three different absences used to be indistinguishable on the queue: a
  /// reading nobody ever asked for, a reading that failed, and a reading that
  /// came back with every field null. All three produced a row that looked
  /// like a document which simply had nothing in it — which is how a real
  /// Relay booking, read as all-nulls, sat in REVIEW looking ordinary
  /// (PHASE-6-BRIEF flag 76).
  ///
  ///   ocrStatus NOT_QUEUED — deferred; the model was never called
  ///   ocrStatus FAILED     — the reader was asked and could not answer
  ///   ocrStatus COMPLETED  — the reader answered and said nothing
  ///
  /// ONE STATE, NOT A TAXONOMY. The queue needs to show that nothing was
  /// read; WHY is a label beside it, not another column to sort by.
  UNREAD
  /// A dispatcher turned it into a load.
  CONFIRMED
  /// A dispatcher said it was not freight.
  DISMISSED
}

// ---------------------------------------------------------------------------
// WHAT A DRIVER HAD EARNED BEFORE ZEBRA WAS THE BOOK OF RECORD.
//
// ── WHY THIS EXISTS AT ALL ────────────────────────────────────────────────
//
// Zebra's revenue starts at the books cutover (MONEY-DESIGN §0a): pre-cutover
// Amazon money never becomes a `Payment` here, because it was received and
// disbursed through Datatruck and the ST-005xxx statements prove the drivers
// were paid. That ruling is right and it breaks exactly one thing — YTD.
//
// YTD is a query over FINAL settlements in the calendar year (§6), so on the
// first Zebra statement it would restart at zero. Hassan Ali Hirsi's Datatruck
// statement of 2026-08-19 prints `YTD Earnings: $146,721.64`; a Zebra
// statement the following week showing a few thousand would be read, correctly,
// as the system having lost his year.
//
// ── AN OPENING BALANCE, NOT AN IMPORT ────────────────────────────────────
//
// The fix is one stated figure per category, not a back-import of the money.
// Importing would create cash entries this system never processed and payments
// applied to loads `SETTLEABLE_LOAD` excludes — money in with no way out.
// A balance adds to a query and claims nothing about what Zebra did.
//
// ── STATED AND DATED, NEVER DERIVED ──────────────────────────────────────
//
// Every figure is transcribed from a printed statement by a person, and the
// row records WHICH statement. Deriving it — summing imported loads, applying
// a pay rule to closed history — would reconstruct a number Datatruck already
// computed under rules this system does not hold, and any drift between the
// two would surface as a driver's year quietly disagreeing with their pay
// stubs. `source` is not decoration: it is how a disputed figure is checked.
//
// ── ONE ROW PER CATEGORY, MIRRORING THE STATEMENT ────────────────────────
//
// The six categories are the ones Datatruck's own summary block prints, so a
// person seeding this reads across a statement and types what is there. A
// single `openingNetPay` column would have been smaller and would not survive
// the first question anybody asks, which is why the number is what it is.
//
// NET PAY IS STORED, NOT COMPUTED, for the same reason: Datatruck prints it,
// and a computed one that disagreed with the printed one would make this table
// an opinion. If they disagree, that is a finding about the statement.
// ---------------------------------------------------------------------------
enum OpeningBalanceCategory {
  EARNINGS
  ADVANCES
  REIMBURSEMENTS
  DEDUCTIONS
  OTHER_PAY
  NET_PAY
}

model DriverOpeningBalance {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  /// The calendar year this balance opens. YTD is per year, so this is too.
  year     Int
  category OpeningBalanceCategory

  /// Integer cents, sign as the statement prints it. Deductions are negative.
  amountCents Int

  /// The day the balance is taken as at — the period end of the last
  /// Datatruck statement, never the day somebody typed it.
  asOf DateTime

  /// Which statement this was read off: `ST-005284`. Not optional by accident.
  source String

  /// Who transcribed it, for a figure nobody can recompute.
  enteredById String?
  enteredBy   User?   @relation(fields: [enteredById], references: [id])

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ONE FIGURE PER DRIVER PER YEAR PER CATEGORY. A second row for the same
  /// three would be two answers to one question, and nothing downstream could
  /// choose between them — so the database refuses rather than the code.
  @@unique([driverId, year, category])
  @@index([organizationId, year])
  @@index([driverId, year])
}

// ---------------------------------------------------------------------------
// STANDING DEDUCTIONS, AND THE ONE-OFFS BESIDE THEM.
//
// Every field below is measured off the six statements in `corpus/datatruck`.
// The acceptance is that the engine reproduces each description they print,
// verbatim, from a stored rule — so this table has to hold whatever those
// strings need and nothing it merely wishes it had.
//
// ── `type` IS A STRING, NOT AN ENUM, AND THAT IS THE RULING ──────────────
//
// Datatruck prints a type column: Fuel, Insurance, Ifta, Admin Fee, Tolls,
// Other, Escrow. It is a LABEL with `Other` as the escape hatch — adding a new
// kind of charge is choosing a label and typing a description, never a
// migration. A closed Prisma enum would make next year's charge a schema
// change, which is exactly what the original "no deduction type enum" ruling
// was protecting. `deduction-types.ts` holds the known list for the UI and for
// the two behaviours that branch; the column accepts anything.
//
// ── SUPERSEDED, NEVER EDITED ─────────────────────────────────────────────
//
// Same posture as `DriverPayRule` and the same reason: these land on
// statements that have already been handed to a person. Changing $450 to $500
// in place would silently restate last month's paperwork. A change closes the
// old row with `effectiveTo` and opens a new one.
// ---------------------------------------------------------------------------

enum DeductionCadence {
  /// A flat amount every settlement period. Ifta, Admin Fee, Escrow.
  WEEKLY

  /// A monthly total collected in weekly instalments — `$1800/$450`. The last
  /// week of a partial month trues up to the day count; see `deductions.ts`.
  MONTHLY_SPLIT_WEEKLY
}

model RecurringDeduction {
  id       String @id @default(cuid())
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  organizationId String // denormalized from Driver — convention 9

  /// The printed label. A string on purpose — see the header.
  type String

  /// What prints in the Description column, or null.
  ///
  /// NULL IS A REAL ANSWER AND NOT A MISSING VALUE: `Ifta` and `Admin Fee`
  /// print no description at all on the real statements. A blank there is a
  /// fact about the charge.
  ///
  /// Where a description varies by period it is stored as a TEMPLATE and
  /// `deductions.ts` fills it — `Insurance (GL, AL, Cargo, TI) for {month}
  /// {split}` produced both `for August $1800/$450` and `for August 24days`
  /// from one stored rule, which is what the acceptance test demands.
  description String?

  /// The instalment taken each period, in cents. Always positive here; the
  /// engine applies the sign, because a deduction and a reimbursement are the
  /// same object with opposite signs.
  amountCents Int

  cadence DeductionCadence

  /// The month's total for MONTHLY_SPLIT_WEEKLY — the `$1800` of `$1800/$450`.
  /// Null for WEEKLY, where the instalment is the whole story.
  monthlyTotalCents Int?

  /// Escrow's target. When the held balance reaches it the rule stops itself
  /// and says so — the one thing Datatruck does not do.
  targetCents Int?

  effectiveFrom DateTime
  effectiveTo   DateTime?
  notes         String?

  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([driverId, effectiveFrom])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// STANDING CHARGES — SPECIFIED, NOT YET A TABLE. MIGRATION 61.
//
// Owner's ruling, 2026-09-30: an ORG-LEVEL recurring deduction. Ifta and Admin
// Fee are the cases — every driver pays them, nobody signs up individually,
// and a driver hired on Tuesday pays one on Friday without anybody adding a
// row. See TMS-DESIGN-SYSTEM §6.2.4 for the surface.
//
// ── WHY `RecurringDeduction` ABOVE CANNOT CARRY IT ────────────────────────
//
// The ruling asked for this to be built against the existing shape if it
// could hold it — "driverId nullable = all" — and it cannot. Three of the six
// fields have no home:
//
//   `driverId` is String NOT NULL with a REQUIRED relation, so there is no
//   way to express "no particular driver".
//
//   There is no column for the applies-to scope. `Driver.employmentType`
//   answers it for a DRIVER; the RULE needs to state which kinds it covers,
//   and that is a property of the rule.
//
//   There is nowhere to record an exemption. "This driver does not pay Ifta"
//   is a decision somebody made and should be able to explain, so it is a row
//   and not an absence.
//
// ── THE WORKAROUND THAT FITS TODAY, AND WHY IT IS REFUSED ─────────────────
//
// One `RecurringDeduction` per driver, fanned out at creation. It needs no
// migration and it is a different feature: editing would mean superseding N
// rows, a driver hired next week would not pick the charge up at all, and
// "applies to owner-operators" would be a filter frozen at creation rather
// than a property of the rule. Recorded here so the next person reaches for
// it and finds the answer already written.
//
// ── WHAT GOES IN, BUNDLED WITH `Payment.isAdjustment` ─────────────────────
//
//   model StandingCharge {
//     id             String @id @default(cuid())
//     organizationId String
//     organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
//
//     /// The printed label, same vocabulary as RecurringDeduction.type and a
//     /// string for the same reason — a new kind of charge is a label, never
//     /// a migration.
//     type        String
//     description String?
//
//     /// The instalment per settlement period, positive. The engine applies
//     /// the sign, as it does for every other charge.
//     amountCents Int
//     cadence     DeductionCadence
//
//     /// Which drivers it reaches. `ALL`, or one `OwnershipType` — the same
//     /// vocabulary `Driver.employmentType` already uses, so the scope and
//     /// the driver are compared in one currency rather than two.
//     appliesTo String
//
//     /// SUPERSEDED, NEVER EDITED, like DriverPayRule and RecurringDeduction:
//     /// these land on statements handed to a person.
//     effectiveFrom DateTime
//     effectiveTo   DateTime?
//     notes         String?
//
//     exemptions StandingChargeExemption[]
//     createdAt  DateTime @default(now())
//
//     @@index([organizationId, effectiveFrom])
//   }
//
//   model StandingChargeExemption {
//     id               String @id @default(cuid())
//     organizationId   String // denormalized — convention 9
//     standingChargeId String
//     standingCharge   StandingCharge @relation(fields: [standingChargeId], references: [id], onDelete: Cascade)
//     driverId         String
//     driver           Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
//
//     /// WHY, and it is required. An exemption nobody can explain is one
//     /// nobody can review.
//     reason    String
//     createdAt DateTime @default(now())
//
//     @@unique([standingChargeId, driverId])
//     @@index([organizationId])
//   }
//
// BOTH CARRY `organizationId`, so both need a row in
// `tests/integration/fixtures.ts` IN THE SAME COMMIT — `isolation-coverage`
// fails by name otherwise, and "sees no rows from the other organization" is
// true of an empty table, which is the comfortable way to be wrong.
// ---------------------------------------------------------------------------

/// A one-off charge or credit on one settlement.
///
/// "Charge for late Del Load#111VS62GS" and a truck-wash reimbursement are THE
/// SAME OBJECT WITH OPPOSITE SIGNS. Two tables would be two sets of rules
/// about a number that only differs by which way it points.
model SettlementCharge {
  id       String @id @default(cuid())
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  organizationId String // denormalized from Driver — convention 9

  /// The printed label, same vocabulary as a recurring deduction's.
  type String

  description String

  /// SIGNED. Negative is money off the driver, positive is money to them.
  amountCents Int

  /// The load it concerns, when it concerns one.
  loadId String?
  load   Load?   @relation(fields: [loadId], references: [id], onDelete: SetNull)

  /// The day this belongs to. The engine picks charges inside the period.
  appliesOn DateTime

  /// Set when a settlement has taken it, so it is never taken twice.
  settledAt DateTime?

  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([driverId, appliesOn])
  @@index([loadId])
  @@index([organizationId])
}

/// The escrow ledger — the one deduction that is a balance rather than a line.
///
/// Incremented on each FINAL settlement (item 3), refundable on termination.
/// A running total is what lets the rule stop itself at its target, and a
/// ledger rather than a column is what makes "why is the balance this" a
/// question with an answer.
model DriverEscrowEntry {
  id       String @id @default(cuid())
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  organizationId String // denormalized from Driver — convention 9

  /// Positive is held from the driver, negative is refunded to them.
  amountCents Int

  /// Which settlement moved it, when a settlement did.
  settlementId String?

  occurredAt DateTime
  notes      String?

  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([driverId, occurredAt])
  @@index([organizationId])
}

/// THE ACCIDENT REGISTER — 49 CFR 390.15(b). One row per occurrence, per
/// company, kept three years after the date of the accident.
///
/// TWO COLUMNS ARE DELIBERATELY ABSENT.
///
/// There is no `deletedAt`. Every other soft-deletable table in this schema
/// has one; a register does not, because it is a document a regulator reads
/// and a row that leaves it silently is the shape of falsification whatever
/// the intent. A mistake is VOIDED — struck through, with a reason and a
/// date, still on the register and still a row that exists.
///
/// There is no `isRecordable`. DOT-recordable is §390.5’s three-part test
/// over `fatalities`, `injuries` and `towedAway`, derived on every read by
/// `isDotRecordable`. A stored flag would be somebody’s opinion on the day
/// they typed it, and if it disagreed with the three numbers beside it the
/// flag would be the lie and the numbers would be the evidence.
///
/// HAZMAT IS RECORDED AND IS NOT PART OF THE TEST — §390.15(b)(2)(vi)
/// requires the register to say whether hazardous materials were released;
/// §390.5 does not count a release as making the occurrence an accident.
model Accident {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// THE COMPANY IS THE REGISTER. §390.15 binds the motor carrier, so a group
  /// running four authorities keeps four registers. Never inferred from the
  /// driver or the truck, either of which may have transferred since.
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  occurredAt DateTime
  /// §390.15(b)(2)(ii): the city or nearest town, and the state.
  city       String?
  state      String?

  /// Both nullable: a bobtail accident in the yard has a driver and no load,
  /// and an accident to a parked trailer may name neither. A blank is a gap
  /// an auditor can see; a required column would be filled with a guess.
  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])
  truckId  String?
  truck    Truck?  @relation(fields: [truckId], references: [id])

  /// §390.15(b)(2)(iv). COUNTS INJURIES MEETING §390.5 — a person who
  /// immediately received medical treatment AWAY FROM THE SCENE — not
  /// everybody who was shaken up. The form says so as well as this comment.
  injuries       Int     @default(0)
  /// §390.15(b)(2)(v).
  fatalities     Int     @default(0)
  /// §390.15(b)(2)(vi). Other than fuel spilled from the fuel tanks of the
  /// vehicles involved, which the regulation excludes by name.
  hazmatReleased Boolean @default(false)
  /// §390.5(iii): disabling damage requiring tow-away. Not printed on the
  /// register; needed to derive whether the occurrence belongs on it.
  towedAway      Boolean @default(false)

  /// LINKED WHEN ONE EXISTS, INDEPENDENT OF IT. Not every accident produces
  /// a claim and not every claim comes from an accident — a cargo claim has
  /// none. The register is complete without it.
  claimId String?
  claim   Claim?  @relation(fields: [claimId], references: [id])

  notes String?

  /// Struck through, not removed. A CHECK in the migration forbids one half
  /// of this pair without the other.
  voidedAt   DateTime?
  voidReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, occurredAt])
  @@index([driverId])
  @@index([claimId])
  @@index([organizationId])
}

/// 49 CFR 382.305(b)'s minimum annual percentage rate, AS DATA.
///
/// The Administrator adjusts this by notice in the Federal Register — it has
/// moved between 25% and 50% for drugs and moved again for 2024. A constant in
/// the source would be correct until the morning it silently was not, and the
/// carrier would under-test for a year with nothing saying so. So a person
/// reads the notice and enters the number, and `citation` is NOT NULL because
/// a rate with no notice behind it is a number somebody remembered.
///
/// Basis points, like every percentage in this schema. 50% is 5000.
model RandomTestingRate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  year           Int
  drugRateBps    Int
  alcoholRateBps Int
  /// e.g. "89 FR 1234 (Jan 2024)". Printed on the year-end summary.
  citation       String
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Created by hand in the migration, with a CHECK that both rates are
  /// percentages. Two rows for one year is two answers to a question with one.
  @@unique([organizationId, year])
}

/// The pool when it comes from a CONSORTIUM rather than from the roster.
///
/// Derived membership — active drivers with a CDL on file — needs no table.
/// A carrier in a consortium or TPA is tested from the consortium's pool,
/// which arrives from outside and is entered as data.
///
/// `driverId` IS NULLABLE BECAUSE THE LIST IS NOT OURS: a consortium pool
/// contains drivers from other carriers, and inventing a Driver row for them
/// would put strangers on the roster. The name is kept either way.
model RandomPoolEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  year           Int
  driverId       String?
  driver         Driver? @relation(fields: [driverId], references: [id])
  name           String
  consortiumName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, year])
  @@index([organizationId])
}

/// ONE QUARTER'S DRAW, AND THE WHOLE AUDIT.
///
/// "Random" to an auditor means "you cannot have chosen who got tested". A
/// selection nobody can re-derive is indistinguishable from a list somebody
/// typed, so three things are stored and the selection is a pure function of
/// them: the SEED, the ALGORITHM by name, and THE POOL AS IT STOOD.
///
/// `poolSnapshot` is the pool in full at the moment of the draw — not a count,
/// and not a reference to a query that would answer differently today. A
/// driver hired in July changes the derived pool, and an April draw must still
/// recompute to the same names in December.
///
/// A CHECK in the migration refuses a draw with no seed, no algorithm, or a
/// snapshot whose length disagrees with `poolSize`.
model RandomDraw {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  year    Int
  quarter Int
  /// DERIVED or CONSORTIUM. TEXT against a code list, per migration 52.
  source  String

  seed         String
  /// Named and versioned, so changing the method is a new name rather than an
  /// old draw quietly becoming unverifiable. See random-testing.ts.
  algorithm    String
  poolSnapshot Json
  poolSize     Int

  drawnAt       DateTime @default(now())
  drawnByUserId String?
  drawnBy       User?    @relation(fields: [drawnByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  selections RandomSelection[]

  @@unique([companyId, year, quarter])
  @@index([organizationId])
}

/// One name out of one draw.
///
/// `memberKey` is what the draw actually selected and what ties this row back
/// to the snapshot; `driverId` is a convenience for the screens and is null
/// for a consortium line belonging to another carrier.
///
/// NOT_TESTED NEEDS A REASON, and a CHECK enforces it. §382.305(j)(3) allows a
/// selected driver to be excused, but the carrier has to say why for each one
/// — "not tested" with no reason is the line an auditor stops on.
model RandomSelection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  drawId String
  draw   RandomDraw @relation(fields: [drawId], references: [id], onDelete: Cascade)

  /// DRUG or ALCOHOL. Two programmes over one pool, drawn independently.
  kind      String
  memberKey String
  driverId  String?
  driver    Driver? @relation(fields: [driverId], references: [id])
  name      String

  /// PENDING, TESTED or NOT_TESTED.
  outcome  String    @default("PENDING")
  reason   String?
  testedAt DateTime?

  /// DEAD SINCE THE RULING OF 2026-09-22, AND KEPT ONLY BECAUSE DROPPING IT
  /// IS A MIGRATION.
  ///
  /// A random test writes no `ComplianceItem` — the outcome is an event on
  /// this row. Nothing reads or writes this column and nothing should; it
  /// is null on every row in every environment. Removing it is one
  /// migration whenever the next one is going out anyway, which is why it
  /// was not bundled into a deploy that had to ship today.
  complianceItemId String?
  complianceItem   ComplianceItem? @relation(fields: [complianceItemId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([drawId, kind, memberKey])
  @@index([drawId])
  @@index([driverId])
  @@index([organizationId])
}
