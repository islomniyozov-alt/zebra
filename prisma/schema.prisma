model FuelTransaction {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  purchasedAt DateTime
  truckId     String?
  truck       Truck?   @relation(fields: [truckId], references: [id])
  driverId    String?
  driver      Driver?  @relation(fields: [driverId], references: [id])
  loadId      String?
  load        Load?    @relation(fields: [loadId], references: [id])

  vendorName String?
  city       String?
  // Jurisdiction matters — this row is also an IFTA fuel purchase.
  state      String?

  // Gallons are genuinely fractional. Decimal, not cents.
  gallons             Decimal @db.Decimal(10, 3)
  pricePerGallonCents Int?
  totalCents          Int
  odometer            Int?
  fuelCardLast4       String?
  isDef               Boolean @default(false)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  documents Document[]

  @@index([companyId, purchasedAt])
  @@index([companyId, truckId, purchasedAt])
  @@index([companyId, state, purchasedAt])
}

model MaintenanceRecord {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  truckId   String?
  truck     Truck?   @relation(fields: [truckId], references: [id])
  trailerId String?
  trailer   Trailer? @relation(fields: [trailerId], references: [id])

  servicedAt  DateTime
  odometer    Int?
  category    MaintenanceCategory
  description String?
  vendorName  String?
  costCents   Int                 @default(0)

  nextServiceOdometer Int?
  nextServiceDate     DateTime?
  notes               String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  documents Document[]

  @@index([companyId, servicedAt])
  @@index([companyId, truckId, servicedAt])
  @@index([companyId, nextServiceDate])
}

enum MaintenanceCategory {
  OIL_CHANGE
  TIRES
  BRAKES
  ENGINE
  TRANSMISSION
  SUSPENSION
  ELECTRICAL
  AFTERTREATMENT
  PREVENTIVE
  DOT_INSPECTION
  TRAILER_SERVICE
  OTHER
}

// Per-jurisdiction mileage. Realistically this gets POPULATED FROM THE ELD
// FEED, not typed in by hand. The table exists now so the integration has
// somewhere to land; do not build a manual-entry UI for it.
model IftaMileage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  truckId String
  truck   Truck  @relation(fields: [truckId], references: [id])

  periodYear    Int
  periodQuarter Int
  jurisdiction  String // "IL", "OH", "ON"

  totalMiles   Int          @default(0)
  taxableMiles Int          @default(0)
  source       StatusSource @default(INTEGRATION)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, truckId, periodYear, periodQuarter, jurisdiction])
  @@index([companyId, periodYear, periodQuarter])
}

