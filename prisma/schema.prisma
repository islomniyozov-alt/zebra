// DRIVER SETTLEMENTS
// ============================================================================

model Settlement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  settlementNumber String // allocated via Counter
  driverId         String
  driver           Driver @relation(fields: [driverId], references: [id])

  periodStart DateTime
  periodEnd   DateTime
  status      SettlementStatus @default(DRAFT)

  grossCents          Int @default(0)
  deductionsCents     Int @default(0)
  reimbursementsCents Int @default(0)
  netCents            Int @default(0)

  approvedByUserId String?
  approvedBy       User?          @relation(fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  paidAt           DateTime?
  paymentMethod    PaymentMethod?
  paymentReference String?
  notes            String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  lines     SettlementLine[]
  documents Document[]

  @@unique([companyId, settlementNumber])
  @@index([companyId, driverId, periodEnd])
  @@index([companyId, status])
}

enum SettlementStatus {
  DRAFT
  APPROVED
  PAID
  VOID
}

model SettlementLine {
  id           String     @id @default(cuid())
  settlementId String
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  organizationId String // denormalized from Settlement — convention 9

  loadId String?
  load   Load?   @relation(fields: [loadId], references: [id])

  type            SettlementLineType
  description     String
  // SIGNED. Earnings positive, deductions negative. Net is a plain SUM.
  amountCents     Int
  // The exact pay rule applied, frozen. A later pay change cannot rewrite
  // this settlement.
  payRuleSnapshot Json?
  sortOrder       Int                @default(0)

  createdAt DateTime @default(now())

  @@index([settlementId])
  @@index([loadId])
  @@index([organizationId])
