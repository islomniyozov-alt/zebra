enum SettlementLineType {
  LOAD_PAY
  ACCESSORIAL_PAY
  BONUS
  REIMBURSEMENT
  DEDUCTION_ADVANCE
  DEDUCTION_FUEL
  DEDUCTION_INSURANCE
  DEDUCTION_ESCROW
  DEDUCTION_EQUIPMENT
  DEDUCTION_VIOLATION
  DEDUCTION_OTHER
}

