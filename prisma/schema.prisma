// ============================================================================
// OPERATIONS SUPPORT
// ============================================================================

model Communication {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  loadId     String?
  load       Load?     @relation(fields: [loadId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  driverId   String?
  driver     Driver?   @relation(fields: [driverId], references: [id])

  type       CommunicationType
  direction  CommunicationDirection @default(OUTBOUND)
  occurredAt DateTime               @default(now())
  subject    String?
  body       String

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId, occurredAt])
  @@index([loadId, occurredAt])
  @@index([customerId, occurredAt])
}

enum CommunicationType {
  CALL
  EMAIL
  SMS
  NOTE
  PORTAL_MESSAGE
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Null = broadcast to every user in the company with the right role.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  type      NotificationType
  severity  NotificationSeverity @default(INFO)
  title     String
  body      String?
  deepLink  String?
  // Prevents "missing POD" firing every hour for the same load.
  dedupeKey String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([companyId, dedupeKey])
  @@index([companyId, userId, readAt])
  @@index([companyId, createdAt])
}

enum NotificationType {
  PICKUP_APPROACHING
  DELIVERY_APPROACHING
  POD_MISSING
  INVOICE_NOT_CREATED
  INVOICE_OVERDUE
  PAYMENT_RECEIVED
  MAINTENANCE_DUE
  COMPLIANCE_EXPIRING
  DISPATCH_CONFLICT
  CLAIM_UPDATE
  SETTLEMENT_READY
  SYSTEM
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

// Most calendar entries are DERIVED (stops, compliance expiries, next service
// dates). This table is only for manual one-off events.
model CalendarEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title    String
  notes    String?
  startsAt DateTime
  endsAt   DateTime?
  allDay   Boolean   @default(false)
  color    String?

  createdByUserId String?
  createdBy       User?   @relation(fields: [createdByUserId], references: [id])

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([companyId, startsAt])
}

// Written automatically by a Prisma client extension, never by hand. Hand
// placed audit calls end up around 60% covered, which is the same as useless.
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // NULLABLE, unlike every other companyId in this schema. Plenty of audited
  // things belong to the organization and to no single authority — a broker, a
  // saved facility, a user's membership. Requiring a company here would mean
  // either inventing one or declining to audit those writes, and the second is
  // how an audit trail quietly becomes 60% covered.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action     AuditAction
  entityType String
  entityId   String
  // { field: { from, to } } — one row per write, not one per field.
  changes    Json?
  ip         String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([companyId, entityType, entityId])
  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  // Company-less rows still have to be findable, and every audit query starts
  // from the tenant.
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  EXPORT
  PERMISSION_CHANGE
}
