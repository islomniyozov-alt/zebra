# Template. Copy to .env and fill in real values — .env is gitignored.
#
# This file is committed, so it holds NO real credentials. The working values
# live in .env only.

# Which Neon branch this environment targets. Required — no default.
# "dev" or "production". prisma.config.ts refuses to guess and fails closed.
NEON_BRANCH="dev"

# Pooled endpoint — the hostname CONTAINS "-pooler". Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct endpoint — the same hostname with "-pooler" REMOVED. Used by
# migrations, DDL and seeds. Running migrations through the pooler hangs with
# no error message, so these two must genuinely differ.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# R2. The access key pair is an S3-compatible token from the Cloudflare
# dashboard — needed to mint presigned URLs, which bindings cannot do.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="zebra-docs-dev"
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"

# Auth — session cookie signing. Generate with:
#   node -e "console.log(crypto.randomUUID().replace(/-/g,'') + crypto.randomUUID().replace(/-/g,''))"
AUTH_SECRET=""
