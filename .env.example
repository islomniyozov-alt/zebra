# Template. Copy to .env and fill in real values — .env is gitignored.
#
# This file is committed, so it holds NO real credentials. The working values
# live in .env only.

# Which Neon branch this environment targets. Required — no default.
# "dev" or "production". prisma.config.ts refuses to guess and fails closed.
NEON_BRANCH="dev"

# TWO URLS, TWO ROLES. This is the tenancy boundary, not a style choice.
#
#   DATABASE_URL         pooled host, role zebra_app   — the application
#   DIRECT_DATABASE_URL  direct host, role <owner>     — migrations and seeds
#
# The Neon owner carries BYPASSRLS: connected as the owner, every row-level
# security policy in the database evaporates. The application therefore
# connects as zebra_app, which owns nothing and has no DDL. src/lib/db.ts
# refuses to start if DATABASE_URL is not zebra_app, and an isolation test
# pointed at DIRECT_DATABASE_URL passes vacuously.
#
# Bootstrapping zebra_app on a new branch — the migration creates the role
# NOLOGIN and passwordless, so grant it login once, out of band:
#
#   ALTER ROLE zebra_app WITH LOGIN PASSWORD '<generated>';

# Pooled endpoint — the hostname CONTAINS "-pooler".
DATABASE_URL="postgresql://zebra_app:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct endpoint — the same hostname with "-pooler" REMOVED. Running
# migrations through the pooler hangs with no error message, so these two must
# genuinely differ.
DIRECT_DATABASE_URL="postgresql://OWNER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# R2. The access key pair is an S3-compatible token from the Cloudflare
# dashboard — needed to mint presigned URLs, which bindings cannot do.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="zebra-docs-dev"
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"

# Auth. Reserved for signing anything that is not a session — session tokens
# are 256 bits of randomness stored as a SHA-256 digest and need no secret.
AUTH_SECRET=""

# Seed only. If unset, `npm run db:seed` generates a password and prints it
# once. There is deliberately no default.
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
