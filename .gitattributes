# Keep the working tree LF on every platform. Prettier is configured with
# endOfLine: lf, so without this `npm run format:check` fails on Windows
# immediately after a clone.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
