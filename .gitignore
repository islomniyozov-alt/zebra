# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# opennext / cloudflare
# cloudflare-env.d.ts is generated by `npm run cf:typegen` but IS committed —
# without it a fresh clone cannot typecheck.
/.open-next/
/.wrangler/

# prisma generated client
/src/generated/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets never enter the repo, the template does
.env*
!.env.example

# Hand-off files for a connection string or a key, used for the length of one
# command and deleted afterwards. Ignored so that a production URL parked here
# for five minutes cannot be committed by an absent-minded `git add -A`.
prod-url.txt
*.secret.txt

# One-off reproduction scripts written at the repo root so they can import the
# project's dependencies. They are diagnostic scaffolding, not tooling — the
# ones worth keeping become scripts/verify-*.mjs. One rode into a commit on a
# `git add -A` before this line existed.
/repro*.mjs

# The integration runner's machine-readable report. Regenerated every run.
.vitest-integration.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
